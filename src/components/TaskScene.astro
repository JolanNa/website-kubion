---
import type { Reading } from '../lib/visionTasks';

/**
 * One vision task, shown on a single part: the part itself (`.part`) and what
 * the system reads from it (`.note`). Drawn for a Marine ground.
 *
 * The two are separate groups so a layout can bring the part in first and the
 * reading after it. Labels are letters and numbers only, so the artwork needs
 * no translation.
 */
interface Props {
  reading: Reading;
  class?: string;
  style?: string;
  [attribute: `data-${string}`]: string;
}

const { reading, class: className, ...attributes } = Astro.props;

const classes = [
  { letter: 'A', y: 110, share: 82 },
  { letter: 'B', y: 150, share: 14 },
  { letter: 'C', y: 190, share: 8 },
];
const findings = [
  { x: 138, y: 108, w: 64, h: 66, score: '0.94' },
  { x: 244, y: 170, w: 42, h: 40, score: '0.88' },
];
---

<svg viewBox="0 0 400 300" class={className} aria-hidden="true" {...attributes}>
  {
    reading === 'classify' && (
      <>
        <g class="part">
          <circle cx="140" cy="150" r="66" class="fill-hellblau" />
          <circle cx="140" cy="150" r="24" class="fill-marine" />
        </g>
        <g class="note">
          <circle cx="140" cy="150" r="90" fill="none" stroke-dasharray="3 6" class="stroke-hellblau" opacity="0.6" />
          <rect x="258" y="97" width="28" height="26" rx="8" class="fill-weiss" />
          {classes.map(({ letter, y, share }, index) => (
            <>
              <text x="272" y={y + 5} text-anchor="middle" class:list={['label', index ? 'fill-hellblau' : 'fill-marine']}>
                {letter}
              </text>
              <rect x="298" y={y - 4} width="84" height="8" rx="4" class="fill-weiss" opacity="0.15" />
              <rect x="298" y={y - 4} width={share} height="8" rx="4" class={index ? 'fill-hellblau' : 'fill-weiss'} />
            </>
          ))}
        </g>
      </>
    )
  }
  {
    reading === 'detect' && (
      <>
        <g class="part">
          <rect x="70" y="70" width="260" height="160" rx="16" class="fill-nebel" />
          <path d="M150 120l40 24-12 18" fill="none" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="stroke-marine-45" />
          <polygon points="254,184 268,180 276,190 270,200 257,199" class="fill-marine-45" />
        </g>
        <g class="note">
          {findings.map((box) => (
            <>
              <rect x={box.x} y={box.y} width={box.w} height={box.h} fill="none" stroke-width="2.5" class="stroke-orange" />
              <rect x={box.x - 1.25} y={box.y - 23} width="50" height="22" class="fill-orange" />
              <text x={box.x + 24} y={box.y - 7} text-anchor="middle" class="label small fill-weiss">{box.score}</text>
            </>
          ))}
        </g>
      </>
    )
  }
  {
    reading === 'inspect' && (
      <>
        <g class="part">
          <circle cx="200" cy="125" r="62" class="fill-hellblau" />
          <circle cx="200" cy="125" r="22" class="fill-marine" />
          <path d="M162 100l32 20-9 16" fill="none" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="stroke-marine" />
        </g>
        <g class="note" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="254" cy="72" r="18" class="fill-orange" />
          <path d="M248 66l12 12m0-12l-12 12" class="stroke-weiss" />
          {/* The scale from reject to accept, the threshold on it, and where this part lands. */}
          <rect x="92" y="233" width="216" height="6" rx="3" class="fill-weiss" opacity="0.2" />
          <path d="M200 222v28" stroke-width="1.5" stroke-dasharray="3 4" class="stroke-hellblau" />
          <path d="M62 230l12 12m0-12l-12 12" class="stroke-hellblau" />
          <path d="M324 237l5 5 9-10" class="stroke-hellblau" />
          <circle cx="118" cy="236" r="9" class="fill-orange" />
          <text x="118" y="216" text-anchor="middle" class="label small fill-orange">0.12</text>
        </g>
      </>
    )
  }
  {
    reading === 'monitor' && (
      <>
        <g class="part">
          <polygon points="262,140 231,193.7 169,193.7 138,140 169,86.3 231,86.3" class="fill-hellblau" />
        </g>
        <g class="note">
          {/* The part the process expects here, against the one that arrived. */}
          <rect x="134" y="74" width="132" height="132" rx="16" fill="none" stroke-width="2" stroke-dasharray="6 6" class="stroke-weiss" />
          <rect x="138" y="236" width="44" height="30" rx="8" fill="none" stroke-dasharray="4 4" class="stroke-hellblau" />
          <text x="160" y="256" text-anchor="middle" class="label fill-hellblau">B</text>
          <text x="200" y="256" text-anchor="middle" class="label fill-weiss">≠</text>
          <rect x="218" y="236" width="44" height="30" rx="8" class="fill-orange" />
          <text x="240" y="256" text-anchor="middle" class="label fill-weiss">C</text>
        </g>
      </>
    )
  }
  {
    reading === 'guide' && (
      <>
        <g class="part">
          <rect x="135" y="95" width="110" height="110" rx="14" transform="rotate(32 190 150)" class="fill-nebel" />
        </g>
        <g class="note">
          <path d="M190 150H300" stroke-dasharray="4 4" class="stroke-hellblau" />
          <path d="M278 150A88 88 0 0 1 264.6 196.6" fill="none" stroke-width="2" class="stroke-orange" />
          <text x="288" y="186" class="label fill-weiss">32°</text>
          <g transform="rotate(32 190 150)">
            <path d="M96 150H284M190 62V238" stroke-width="1.5" class="stroke-orange" />
            <rect x="113" y="118" width="14" height="64" rx="3" class="fill-orange" />
            <rect x="253" y="118" width="14" height="64" rx="3" class="fill-orange" />
          </g>
          <circle cx="190" cy="150" r="6" class="fill-orange" />
          <rect x="122" y="14" width="136" height="26" rx="13" class="fill-weiss" />
          <text x="190" y="32" text-anchor="middle" class="label small fill-marine">x 190 · y 150</text>
        </g>
      </>
    )
  }
</svg>

<style>
  .label {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
  }

  .label.small {
    font-size: 12.5px;
  }
</style>
