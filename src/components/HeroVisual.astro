---
import type { Locale } from '../config';

/**
 * Looping inspection-line visual, right of the homepage headline.
 *
 * What kubion builds, shown as a live view: a camera over a conveyor, parts
 * running through its field of view, each one judged as it passes the centre
 * (OK / NIO with a confidence), defective parts ejected off the line, and the
 * counters and a confidence trace updating underneath.
 *
 * Same visual language as the hero intro: thin Hellblau lines on Marine, Geist
 * Mono readouts, orange only for the live dot and rejected parts. Decorative —
 * hidden from assistive technology. The figures are illustrative, not data.
 *
 * Shown from `lg` up; below that the hero is text only. Animates only while on
 * screen; with reduced motion it renders one still frame of the same scene.
 */
interface Props {
  labels: {
    status: string;
    title: string;
    inspected: string;
    rejected: string;
    confidence: string;
    ok: string;
    nok: string;
  };
  locale: Locale;
}

const { labels, locale } = Astro.props;
---

<div
  data-reveal
  data-hero-visual
  data-ok={labels.ok}
  data-nok={labels.nok}
  data-locale={locale}
  class="hidden lg:block"
  aria-hidden="true"
>
  <div class="rounded-2xl border border-hellblau/15 bg-white/[0.025] p-5 xl:p-6">
    <div class="flex items-center justify-between gap-4">
      <p class="kicker flex items-center gap-2 text-hellblau/80">
        <span data-hv-live class="size-1.5 rounded-full bg-orange"></span>
        {labels.status}
      </p>
      <p class="kicker text-hellblau/45">{labels.title}</p>
    </div>

    <svg data-hv-scene viewBox="0 0 480 290" class="mt-4 block w-full" fill="none">
      <defs>
        <clipPath id="hv-fov">
          <polygon points="240,58 172,214 308,214" />
        </clipPath>
      </defs>

      {/* Field of view. */}
      <polygon points="240,58 172,214 308,214" class="hv-fov-fill" />
      <path d="M240 58L172 214M240 58L308 214" class="hv-line-faint" stroke-dasharray="3 5" />
      <line data-hv-scan x1="160" x2="320" y1="120" y2="120" class="hv-scan" clip-path="url(#hv-fov)" />

      {/* Camera: mount, housing, lens, status LED. */}
      <g class="hv-line">
        <path d="M240 0V20" />
        <rect x="214" y="20" width="52" height="28" rx="4" />
        <rect x="230" y="48" width="20" height="8" rx="1.5" />
      </g>
      <circle data-hv-led cx="257" cy="34" r="2" class="hv-orange-fill" />

      {/* Conveyor. */}
      <line x1="0" x2="480" y1="230" y2="230" class="hv-line" />
      <line data-hv-rollers x1="0" x2="480" y1="240" y2="240" class="hv-rollers" stroke-dasharray="0.1 16" />

      <g data-hv-parts></g>
    </svg>

    <div class="mt-4 grid grid-cols-[auto_auto_1fr] items-end gap-6 border-t border-hellblau/15 pt-4 xl:gap-8">
      <div>
        <p class="kicker text-hellblau/45">{labels.inspected}</p>
        <p data-hv-inspected class="mt-1 font-mono text-xl text-weiss tabular-nums">0</p>
      </div>
      <div>
        <p class="kicker text-hellblau/45">{labels.rejected}</p>
        <p data-hv-rejected class="mt-1 font-mono text-xl text-weiss tabular-nums">0</p>
      </div>
      <div class="min-w-0">
        <p class="kicker flex justify-between gap-2 text-hellblau/45">
          <span>{labels.confidence}</span>
          <span data-hv-conf class="text-hellblau/80 tabular-nums">–</span>
        </p>
        <svg viewBox="0 0 200 36" preserveAspectRatio="none" class="mt-2 block h-7 w-full" fill="none">
          <polyline data-hv-trace class="hv-trace" vector-effect="non-scaling-stroke" />
        </svg>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Global because the script creates the parts' elements at runtime. */
  [data-hero-visual] .hv-line {
    stroke: color-mix(in srgb, var(--color-hellblau) 55%, transparent);
    stroke-width: 1.25;
  }
  [data-hero-visual] .hv-line-faint {
    stroke: color-mix(in srgb, var(--color-hellblau) 28%, transparent);
    stroke-width: 1;
  }
  [data-hero-visual] .hv-fov-fill {
    fill: color-mix(in srgb, var(--color-hellblau) 5%, transparent);
  }
  [data-hero-visual] .hv-scan {
    stroke: color-mix(in srgb, var(--color-hellblau) 45%, transparent);
    stroke-width: 1;
  }
  [data-hero-visual] .hv-rollers {
    stroke: color-mix(in srgb, var(--color-hellblau) 30%, transparent);
    stroke-width: 3;
    stroke-linecap: round;
  }
  [data-hero-visual] .hv-orange-fill {
    fill: var(--color-orange);
  }
  [data-hero-visual] .hv-part {
    stroke: color-mix(in srgb, var(--color-hellblau) 70%, transparent);
    stroke-width: 1.25;
    fill: color-mix(in srgb, var(--color-hellblau) 8%, transparent);
  }
  [data-hero-visual] .hv-crack {
    stroke: color-mix(in srgb, var(--color-hellblau) 70%, transparent);
    stroke-width: 1.25;
    fill: none;
  }
  [data-hero-visual] .hv-box {
    stroke: var(--color-weiss);
    stroke-width: 1.25;
    fill: none;
  }
  [data-hero-visual] .hv-label {
    fill: var(--color-weiss);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
  }
  [data-hero-visual] .is-nok .hv-box {
    stroke: var(--color-orange);
  }
  [data-hero-visual] .is-nok .hv-label {
    fill: var(--color-orange);
  }
  [data-hero-visual] .hv-trace {
    stroke: color-mix(in srgb, var(--color-hellblau) 80%, transparent);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }
</style>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';

  // Scene geometry, in viewBox units (0 0 480 290).
  const WIDTH = 480;
  const CENTRE = 240; // the camera's axis: parts are judged as they cross it
  const PART_Y = 207; // a part's centre while it sits on the belt
  const SPEED = 52; // px per second
  const GAP = 124; // distance between parts
  const EJECT_AT = 338; // where a rejected part is pushed off the line
  const DEFECT_EVERY = 6;
  const TRACE_POINTS = 24;

  type Part = {
    x: number;
    y: number;
    vy: number;
    defect: boolean;
    judged: boolean;
    since: number; // seconds since judged
    g: SVGGElement;
    box: SVGGElement;
  };

  function el<K extends keyof SVGElementTagNameMap>(
    tag: K,
    parent: Element,
    attrs: Record<string, string | number> = {},
  ): SVGElementTagNameMap[K] {
    const node = document.createElementNS(SVG_NS, tag);
    for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, String(value));
    parent.append(node);
    return node;
  }

  /** Three part shapes, so the line reads as production rather than a pattern. */
  function drawShape(g: SVGGElement, kind: number) {
    if (kind === 0) el('rect', g, { x: -18, y: -18, width: 36, height: 36, rx: 4, class: 'hv-part' });
    else if (kind === 1) el('circle', g, { r: 19, class: 'hv-part' });
    else {
      const pts = Array.from({ length: 6 }, (_, i) => {
        const a = (Math.PI / 3) * i + Math.PI / 6;
        return `${(20 * Math.cos(a)).toFixed(1)},${(20 * Math.sin(a)).toFixed(1)}`;
      });
      el('polygon', g, { points: pts.join(' '), class: 'hv-part' });
    }
    // An inner detail (bore), so the shapes read as machined parts.
    el('circle', g, { r: 5, class: 'hv-part' });
  }

  function initHeroVisual() {
    const root = document.querySelector<HTMLElement>('[data-hero-visual]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = 'true';

    const layer = root.querySelector<SVGGElement>('[data-hv-parts]')!;
    const scan = root.querySelector<SVGLineElement>('[data-hv-scan]')!;
    const rollers = root.querySelector<SVGLineElement>('[data-hv-rollers]')!;
    const led = root.querySelector<SVGCircleElement>('[data-hv-led]')!;
    const live = root.querySelector<HTMLElement>('[data-hv-live]')!;
    const inspectedEl = root.querySelector<HTMLElement>('[data-hv-inspected]')!;
    const rejectedEl = root.querySelector<HTMLElement>('[data-hv-rejected]')!;
    const confEl = root.querySelector<HTMLElement>('[data-hv-conf]')!;
    const trace = root.querySelector<SVGPolylineElement>('[data-hv-trace]')!;

    const ok = root.dataset.ok ?? 'OK';
    const nok = root.dataset.nok ?? 'NIO';
    const format = new Intl.NumberFormat(root.dataset.locale === 'en' ? 'en-GB' : 'de-DE');
    const confFormat = new Intl.NumberFormat(root.dataset.locale === 'en' ? 'en-GB' : 'de-DE', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

    const parts: Part[] = [];
    const confidences: number[] = [];
    let spawned = 0;
    let inspected = 12_480;
    let rejected = 97;
    let time = 0;

    function spawn(x: number) {
      const defect = spawned % DEFECT_EVERY === DEFECT_EVERY - 2;
      const g = el('g', layer);
      drawShape(g, spawned % 3);
      if (defect) el('path', g, { d: 'M-7 -15L1 -5L-4 0L5 14', class: 'hv-crack' });

      // Detection box: four corner brackets and a label, hidden until judged.
      const box = el('g', g, { opacity: 0 });
      const s = 27;
      const a = 8;
      el('path', box, {
        class: 'hv-box',
        d:
          `M${-s} ${-s + a}V${-s}H${-s + a}M${s - a} ${-s}H${s}V${-s + a}` +
          `M${s} ${s - a}V${s}H${s - a}M${-s + a} ${s}H${-s}V${s - a}`,
      });
      el('text', box, { x: -s, y: -s - 7, class: 'hv-label' });

      parts.push({ x, y: PART_Y, vy: 0, defect, judged: false, since: 0, g, box });
      spawned++;
    }

    function judge(part: Part) {
      part.judged = true;
      const conf = part.defect ? 0.88 + Math.random() * 0.07 : 0.94 + Math.random() * 0.055;
      part.box.querySelector('text')!.textContent = `${part.defect ? nok : ok} ${conf.toFixed(2)}`;
      part.g.classList.toggle('is-nok', part.defect);
      inspected++;
      if (part.defect) rejected++;
      confidences.push(conf);
      if (confidences.length > TRACE_POINTS) confidences.shift();
    }

    function step(dt: number) {
      time += dt;
      for (const part of parts) {
        part.x += SPEED * dt;
        if (!part.judged && part.x >= CENTRE) judge(part);
        if (part.judged) part.since += dt;
        // Rejected parts drop off the line past the ejector.
        if (part.defect && part.x >= EJECT_AT) {
          part.vy += 700 * dt;
          part.y += part.vy * dt;
        }
      }
      for (let i = parts.length - 1; i >= 0; i--) {
        if (parts[i].x > WIDTH + 40 || parts[i].y > 320) {
          parts[i].g.remove();
          parts.splice(i, 1);
        }
      }
      const leftmost = parts.reduce((min, p) => Math.min(min, p.x), Infinity);
      if (leftmost === Infinity || leftmost >= GAP - 40) spawn(leftmost === Infinity ? -40 : leftmost - GAP);
    }

    function render() {
      for (const part of parts) {
        part.g.setAttribute('transform', `translate(${part.x.toFixed(2)} ${part.y.toFixed(2)})`);
        const appear = Math.min(1, part.since / 0.2);
        const leave = Math.min(1, Math.max(0, (WIDTH + 30 - part.x) / 60));
        const fall = part.defect ? Math.max(0, 1 - (part.y - PART_Y) / 70) : 1;
        part.box.setAttribute('opacity', (part.judged ? appear * leave : 0).toFixed(3));
        part.g.setAttribute('opacity', (Math.min(1, (part.x + 40) / 50) * leave * fall).toFixed(3));
      }
      const scanY = 136 + 64 * Math.sin(time * 2.4);
      scan.setAttribute('y1', scanY.toFixed(2));
      scan.setAttribute('y2', scanY.toFixed(2));
      rollers.setAttribute('stroke-dashoffset', (-(time * SPEED) % 16).toFixed(2));
      const on = Math.floor(time * 1.6) % 2 === 0;
      led.setAttribute('opacity', on ? '1' : '0.25');
      live.style.opacity = on ? '1' : '0.35';

      inspectedEl.textContent = format.format(inspected);
      rejectedEl.textContent = format.format(rejected);
      const last = confidences[confidences.length - 1];
      confEl.textContent = last === undefined ? '–' : confFormat.format(last);
      trace.setAttribute(
        'points',
        confidences
          .map((c, i) => {
            const x = (i / (TRACE_POINTS - 1)) * 200;
            const y = 34 - ((c - 0.85) / 0.15) * 32;
            return `${x.toFixed(1)},${y.toFixed(1)}`;
          })
          .join(' '),
      );
    }

    // Start mid-run, with the line full and a trace already drawn.
    const warmup = (GAP * TRACE_POINTS) / SPEED;
    for (let t = 0; t < warmup; t += 1 / 30) step(1 / 30);
    render();

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let frame = 0;
    let previous = 0;
    const tick = (now: number) => {
      // Clamp the step so a backgrounded tab does not jump the scene on return.
      const dt = previous ? Math.min(0.05, (now - previous) / 1000) : 0;
      previous = now;
      step(dt);
      render();
      frame = requestAnimationFrame(tick);
    };

    // Run only while on screen (and laid out — it is display:none below lg).
    new IntersectionObserver(([entry]) => {
      cancelAnimationFrame(frame);
      previous = 0;
      if (entry.isIntersecting) frame = requestAnimationFrame(tick);
    }).observe(root);
  }

  // Same pattern as Header.astro: `astro:page-load` only fires with client-side
  // routing enabled, so also run once directly.
  document.addEventListener('astro:page-load', initHeroVisual);
  initHeroVisual();
</script>
