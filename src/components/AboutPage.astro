---
import { Image } from 'astro:assets';
import type { Locale } from '../config';
import { getTeam, loadPage, pageAlternates } from '../lib/content';
import { requireImage, resolveImage } from '../lib/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutHero from './AboutHero.astro';
import AboutStats from './AboutStats.astro';
import CtaPanel from './CtaPanel.astro';
import DraftTag from './DraftTag.astro';
import SectionHeader from './SectionHeader.astro';
import Steps from './Steps.astro';

/**
 * The Über-uns page: who we are, how kubion started, the key figures, the team,
 * how we work, and a way to get in touch. Team and "about" are one page on
 * purpose, so the nav needs a single entry for both.
 *
 * Section copy comes from src/content/pages/ueber-uns/<locale>.mdx frontmatter
 * (DECISIONS.md §3); the people come from the CMS-managed team collection.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const source = `src/content/pages/ueber-uns/${locale}.mdx`;
const entry = await loadPage('ueber-uns', locale);
const { hero, about } = entry.data;

if (!hero || !about) {
  throw new Error(`The Über-uns page needs a \`hero\` and an \`about\` block in ${source}.`);
}

const storyImage = requireImage(about.story.image, source);

const team = await getTeam(locale);

/** The two large one-sentence statements (after the hero, after the story). */
const statement =
  'mt-8 max-w-[26ch] text-[clamp(2rem,4.2vw,4rem)] leading-[1.08] font-bold tracking-[-0.03em] text-balance';

/**
 * A statement as quoted words: typographic quotes for the locale, each word in
 * its own span so the scroll script can colour it in as the reader passes.
 */
const [quoteOpen, quoteClose] = locale === 'de' ? ['„', '“'] : ['“', '”'];
const quoteWords = (text: string) => `${quoteOpen}${text}${quoteClose}`.split(' ');

const partnersImage = requireImage(about.partners.image, source);

const gallery = about.gallery.items.map((item) => ({
  image: requireImage(item.image, source),
  alt: item.alt,
}));

/** Stands in for the portrait until a photo is uploaded. */
function initials(name: string): string {
  const parts = name.trim().split(/\s+/);
  return [parts[0], parts.length > 1 ? parts.at(-1) : undefined]
    .map((part) => part?.[0] ?? '')
    .join('')
    .toUpperCase();
}
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  alternates={pageAlternates('ueber-uns')}
  ogImage={entry.data.ogImage}
  noindex={entry.data.noindex}
>
  {/*
    Pre-hide the scroll reveals BEFORE first paint, only when motion is allowed
    and the browser can observe. The timeout is a failsafe: if the reveal script
    never binds, everything is shown rather than staying invisible.
  */}
  <script is:inline>
    (function (root) {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!('IntersectionObserver' in window)) return;
      root.dataset.motion = 'pending';
      setTimeout(function () {
        if (root.dataset.motion === 'pending') delete root.dataset.motion;
      }, 4000);
    })(document.documentElement);
  </script>

  <AboutHero hero={hero} locale={locale} />

  <section class="px-4 pt-20 sm:px-16 lg:px-20 lg:pt-32">
    <div class="mx-auto max-w-[84rem]">
      <span class="gradient-orange block h-1.5 w-16" aria-hidden="true"></span>
      <p class={statement} data-quote>
        {quoteWords(about.statement.text).map((word) => <span data-word>{`${word} `}</span>)}
      </p>
      {about.statement.draft && <DraftTag locale={locale} class="mt-6" />}
    </div>
  </section>

  <section class="px-4 py-20 sm:px-16 lg:px-20 lg:py-32">
    <div class="mx-auto grid max-w-[84rem] gap-12 lg:grid-cols-2 lg:gap-20">
      <div data-scroll-reveal>
        {about.story.kicker && <p class="kicker text-marine-70">{about.story.kicker}</p>}
        <h2
          class="mt-6 max-w-[18ch] text-3xl leading-[1.05] font-bold tracking-[-0.02em] text-balance sm:text-5xl"
        >
          {about.story.heading}
        </h2>
        {about.story.draft && <DraftTag locale={locale} class="mt-5" />}
        <div class="mt-10 space-y-5 text-lg leading-relaxed text-pretty text-marine-70">
          {about.story.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      {/* Sticks beside the story on wide screens, so the photo stays in view. */}
      <div data-scroll-reveal class="lg:sticky lg:top-[calc(var(--header-height)+2rem)] lg:self-start">
        <Image
          src={storyImage}
          alt={about.story.imageAlt}
          widths={[480, 720, 1040, 1386]}
          sizes="(min-width: 1024px) 40rem, 100vw"
          class="aspect-[4/3] w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

<section class="px-4 pb-20 sm:px-16 lg:px-20 lg:pb-32">
    <div class="mx-auto flex max-w-[84rem] flex-col items-end text-right">
      <span class="gradient-orange block h-1.5 w-16" aria-hidden="true"></span>
      <p class={statement} data-quote>
        {quoteWords(about.location.text).map((word) => <span data-word>{`${word} `}</span>)}
      </p>
      {about.location.draft && <DraftTag locale={locale} class="mt-6" />}
    </div>
  </section>

  {/*
    Photo strip, running left on its own. The set is rendered twice so the
    loop is seamless; the copy is hidden from assistive tech. Pauses on hover,
    and with reduced motion it becomes a strip you scroll by hand.
  */}
  <section aria-label={about.gallery.label} class="gallery pb-20 lg:pb-32">
    <ul class="gallery-track flex w-max">
      {
        [...gallery, ...gallery].map((photo, i) => {
          const copy = i >= gallery.length;
          return (
            <li class="w-[clamp(17rem,32vw,30rem)] shrink-0 pr-4" aria-hidden={copy ? 'true' : undefined}>
              <Image
                src={photo.image}
                alt={copy ? '' : photo.alt}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 30rem, 70vw"
                class="aspect-[3/2] w-full object-cover"
                loading="lazy"
              />
            </li>
          );
        })
      }
    </ul>
  </section>

  <AboutStats stats={about.stats} locale={locale} />

  <section class="px-4">
    <div class="rounded-3xl bg-nebel px-6 py-16 sm:px-12 lg:px-16 lg:py-24">
      <div class="mx-auto max-w-[84rem]">
        <SectionHeader section={about.team} locale={locale} />

        <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 sm:gap-x-6 lg:mt-16 lg:gap-x-8 lg:gap-y-14">
          {
            team.map((member) => {
              const photo = resolveImage(member.data.photo);
              return (
                <li data-scroll-reveal class="group">
                  {photo ? (
                    <div class="overflow-hidden">
                    <Image
                      src={photo}
                      alt=""
                      widths={[320, 480, 640, 880]}
                      sizes="(min-width: 1024px) 26rem, (min-width: 640px) 33vw, 50vw"
                      class="aspect-square w-full object-cover transition-transform duration-700 ease-[var(--ease-out-quint)] group-hover:scale-105"
                      loading="lazy"
                    />
                    </div>
                  ) : (
                    <div
                      class="flex aspect-square w-full items-center justify-center bg-hellblau font-mono text-3xl tracking-[0.14em] text-marine"
                      aria-hidden="true"
                    >
                      {initials(member.data.name)}
                    </div>
                  )}
                  <p class="mt-4 text-lg font-semibold tracking-[-0.01em]">{member.data.name}</p>
                  <p class="mt-1.5 font-mono text-sm text-marine-70">{member.data.role}</p>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="px-4 py-20 sm:px-16 lg:px-20 lg:py-28">
    <div class="mx-auto max-w-[84rem] text-center" data-scroll-reveal>
      <h2 class="kicker text-marine-70">{about.partners.heading}</h2>
      <Image
        src={partnersImage}
        alt={about.partners.imageAlt}
        widths={[720, 1443]}
        sizes="(min-width: 1024px) 64rem, 100vw"
        class="mx-auto mt-10 h-auto w-full max-w-5xl"
        loading="lazy"
      />
    </div>
  </section>

  <section class="px-4 py-20 sm:px-16 lg:px-20 lg:py-32">
    <div class="mx-auto max-w-[84rem]">
      <SectionHeader section={about.collaboration} locale={locale} />
      <Steps items={about.collaboration.steps} class="mt-12 lg:mt-16" />
    </div>
  </section>

  <CtaPanel section={about.cta} locale={locale} source={source} />
</BaseLayout>

<style is:global>
  /* Scroll reveals (see the script below); only while the page is in motion mode. */
  [data-motion] [data-scroll-reveal] {
    transition:
      opacity 0.9s var(--ease-out-quint),
      transform 0.9s var(--ease-out-quint);
    transition-delay: var(--reveal-delay, 0ms);
  }
  [data-motion] [data-scroll-reveal]:not([data-revealed]) {
    opacity: 0;
    transform: translateY(28px);
  }

  /* Quotes colour in word by word as they scroll through the viewport. */
  [data-motion] [data-quote] [data-word] {
    color: var(--color-marine-15);
    transition: color 0.35s ease-out;
  }
  [data-motion] [data-quote] [data-word][data-lit] {
    color: var(--color-marine);
  }

  /* Photo strip: two identical halves, so -50% loops seamlessly. */
  .gallery {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .gallery-track {
    animation: gallery 70s linear infinite;
  }
  .gallery-track:hover {
    animation-play-state: paused;
  }
  @keyframes gallery {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery {
      overflow-x: auto;
    }
    .gallery-track {
      animation: none;
    }
  }
</style>

<script>
  /**
   * Scroll reveals and the quote fill.
   *
   * Sections fade up as they scroll in; elements that enter together are
   * staggered so they appear one after another. With reduced motion the inline
   * script never set `data-motion`, so this does nothing and the page is static.
   * (The figures count themselves up, see AboutStats.astro.)
   *
   * Initialised directly and on `astro:page-load` (DECISIONS.md §12).
   */
  const STAGGER_MS = 140;

  function initReveals() {
    const root = document.documentElement;
    if (root.dataset.motion !== 'pending') return;
    root.dataset.motion = 'bound';

    const items = [...document.querySelectorAll<HTMLElement>('[data-scroll-reveal]')];

    const observer = new IntersectionObserver(
      (entries) => {
        entries
          .filter((entry) => entry.isIntersecting)
          .forEach((entry, index) => {
            const item = entry.target as HTMLElement;
            const delay = index * STAGGER_MS;
            item.style.setProperty('--reveal-delay', `${delay}ms`);
            item.dataset.revealed = '';
            observer.unobserve(item);
          });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
    );
    items.forEach((item) => observer.observe(item));
  }

  /**
   * Quote fill: a quote's words light up in order while it travels from the
   * lower part of the viewport to the upper third. Only in motion mode.
   */
  function initQuotes() {
    if (!document.documentElement.dataset.motion) return;
    const quotes = [...document.querySelectorAll<HTMLElement>('[data-quote]')].map((quote) => ({
      quote,
      words: [...quote.querySelectorAll<HTMLElement>('[data-word]')],
    }));
    if (quotes.length === 0 || quotes[0].quote.dataset.bound) return;
    quotes.forEach(({ quote }) => (quote.dataset.bound = 'true'));

    let queued = false;
    const update = () => {
      queued = false;
      const vh = window.innerHeight;
      for (const { quote, words } of quotes) {
        const top = quote.getBoundingClientRect().top;
        const progress = Math.min(Math.max((vh * 0.85 - top) / (vh * 0.5), 0), 1);
        const lit = Math.round(progress * words.length);
        words.forEach((word, i) => word.toggleAttribute('data-lit', i < lit));
      }
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();
  }

  function init() {
    initReveals();
    initQuotes();
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>
