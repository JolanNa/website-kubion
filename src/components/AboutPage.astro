---
import { Image } from 'astro:assets';
import type { Locale } from '../config';
import { getTeam, loadPage, pageAlternates } from '../lib/content';
import { requireImage, resolveImage } from '../lib/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutHero from './AboutHero.astro';
import CtaPanel from './CtaPanel.astro';
import DraftTag from './DraftTag.astro';
import SectionHeader from './SectionHeader.astro';
import Steps from './Steps.astro';

/**
 * The Über-uns page: who we are, how kubion started, the key figures, the team,
 * how we work, and a way to get in touch. Team and "about" are one page on
 * purpose, so the nav needs a single entry for both.
 *
 * Section copy comes from src/content/pages/ueber-uns/<locale>.mdx frontmatter
 * (DECISIONS.md §3); the people come from the CMS-managed team collection.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const source = `src/content/pages/ueber-uns/${locale}.mdx`;
const entry = await loadPage('ueber-uns', locale);
const { hero, about } = entry.data;

if (!hero || !about) {
  throw new Error(`The Über-uns page needs a \`hero\` and an \`about\` block in ${source}.`);
}

const storyImage = requireImage(about.story.image, source);
const numberFormat = new Intl.NumberFormat(locale === 'de' ? 'de-DE' : 'en-GB');

const team = await getTeam(locale);

/** Stands in for the portrait until a photo is uploaded. */
function initials(name: string): string {
  const parts = name.trim().split(/\s+/);
  return [parts[0], parts.length > 1 ? parts.at(-1) : undefined]
    .map((part) => part?.[0] ?? '')
    .join('')
    .toUpperCase();
}
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  alternates={pageAlternates('ueber-uns')}
  ogImage={entry.data.ogImage}
  noindex={entry.data.noindex}
>
  {/*
    Pre-hide the scroll reveals BEFORE first paint, only when motion is allowed
    and the browser can observe. The timeout is a failsafe: if the reveal script
    never binds, everything is shown rather than staying invisible.
  */}
  <script is:inline>
    (function (root) {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!('IntersectionObserver' in window)) return;
      root.dataset.motion = 'pending';
      setTimeout(function () {
        if (root.dataset.motion === 'pending') delete root.dataset.motion;
      }, 4000);
    })(document.documentElement);
  </script>

  <AboutHero hero={hero} locale={locale} />

  <section class="px-4 py-20 sm:px-16 lg:px-20 lg:py-32">
    <div class="mx-auto grid max-w-[84rem] gap-12 lg:grid-cols-2 lg:gap-20">
      <div data-scroll-reveal>
        {about.story.kicker && <p class="kicker text-marine-70">{about.story.kicker}</p>}
        <h2
          class="mt-6 max-w-[18ch] text-3xl leading-[1.05] font-bold tracking-[-0.02em] text-balance sm:text-5xl"
        >
          {about.story.heading}
        </h2>
        {about.story.draft && <DraftTag locale={locale} class="mt-5" />}
        <div class="mt-10 space-y-5 text-lg leading-relaxed text-pretty text-marine-70">
          {about.story.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      {/* Sticks beside the story on wide screens, so the photo stays in view. */}
      <div data-scroll-reveal class="lg:sticky lg:top-[calc(var(--header-height)+2rem)] lg:self-start">
        <Image
          src={storyImage}
          alt={about.story.imageAlt}
          widths={[480, 720, 1040, 1386]}
          sizes="(min-width: 1024px) 40rem, 100vw"
          class="aspect-[4/3] w-full rounded-3xl object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="px-4 pb-20 sm:px-16 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-[84rem]">
      <div class="flex flex-wrap items-center gap-4">
        {about.stats.kicker && <p class="kicker text-marine-70">{about.stats.kicker}</p>}
        {about.stats.draft && <DraftTag locale={locale} />}
      </div>
      <dl class="mt-8 grid border-t border-marine-15 sm:grid-cols-3">
        {
          about.stats.items.map((stat) => (
            <div
              data-scroll-reveal
              class="flex flex-col-reverse border-b border-marine-15 py-8 sm:border-b-0 sm:border-l sm:py-12 sm:pl-8 sm:first:border-l-0 sm:first:pl-0"
            >
              <dt class="mt-3 text-lg font-medium text-marine-70">{stat.label}</dt>
              <dd class="text-[clamp(4rem,9vw,8.5rem)] leading-[0.9] font-black tracking-[-0.04em] tabular-nums">
                {/* The animated figure is decorative; screen readers get the final value. */}
                <span class="sr-only">{`${numberFormat.format(stat.value)}${stat.suffix}`}</span>
                <span aria-hidden="true">
                  <span data-count-to={stat.value}>{numberFormat.format(stat.value)}</span>
                  {stat.suffix && <span class="text-orange">{stat.suffix}</span>}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="px-4">
    <div class="rounded-3xl bg-nebel px-6 py-16 sm:px-12 lg:px-16 lg:py-24">
      <div class="mx-auto max-w-[84rem]">
        <SectionHeader section={about.team} locale={locale} />

        <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 sm:gap-x-6 lg:mt-16 lg:gap-x-8 lg:gap-y-14">
          {
            team.map((member) => {
              const photo = resolveImage(member.data.photo);
              return (
                <li data-scroll-reveal>
                  {photo ? (
                    <Image
                      src={photo}
                      alt=""
                      widths={[320, 480, 640, 880]}
                      sizes="(min-width: 1024px) 26rem, (min-width: 640px) 33vw, 50vw"
                      class="aspect-square w-full rounded-2xl object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <div
                      class="flex aspect-square w-full items-center justify-center rounded-2xl bg-hellblau font-mono text-3xl tracking-[0.14em] text-marine"
                      aria-hidden="true"
                    >
                      {initials(member.data.name)}
                    </div>
                  )}
                  <p class="mt-4 text-lg font-semibold tracking-[-0.01em]">{member.data.name}</p>
                  <p class="mt-1.5 font-mono text-sm text-marine-70">{member.data.role}</p>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="px-4 py-20 sm:px-16 lg:px-20 lg:py-32">
    <div class="mx-auto max-w-[84rem]">
      <SectionHeader section={about.collaboration} locale={locale} />
      <Steps items={about.collaboration.steps} class="mt-12 lg:mt-16" />
    </div>
  </section>

  <CtaPanel section={about.cta} locale={locale} source={source} />
</BaseLayout>

<style is:global>
  /* Scroll reveals (see the script below); only while the page is in motion mode. */
  [data-motion] [data-scroll-reveal] {
    transition:
      opacity 0.9s var(--ease-out-quint),
      transform 0.9s var(--ease-out-quint);
    transition-delay: var(--reveal-delay, 0ms);
  }
  [data-motion] [data-scroll-reveal]:not([data-revealed]) {
    opacity: 0;
    transform: translateY(28px);
  }
</style>

<script>
  /**
   * Scroll reveals and the counting figures.
   *
   * Sections fade up as they scroll in; elements that enter together are
   * staggered so they appear one after another. A figure counts up from zero
   * once its tile is revealed. With reduced motion the inline script never set
   * `data-motion`, so this does nothing and the page is static.
   *
   * Initialised directly and on `astro:page-load` (DECISIONS.md §12).
   */
  const STAGGER_MS = 140;
  const COUNT_MS = 1600;

  function countUp(el: HTMLElement, delay: number) {
    const target = Number(el.dataset.countTo);
    const format = new Intl.NumberFormat(document.documentElement.lang || 'de');
    const easeOutQuint = (t: number) => 1 - Math.pow(1 - t, 5);
    let start: number | undefined;

    const step = (now: number) => {
      start ??= now + delay;
      const t = Math.min(Math.max((now - start) / COUNT_MS, 0), 1);
      el.textContent = format.format(Math.round(target * easeOutQuint(t)));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  function initReveals() {
    const root = document.documentElement;
    if (root.dataset.motion !== 'pending') return;
    root.dataset.motion = 'bound';

    const items = [...document.querySelectorAll<HTMLElement>('[data-scroll-reveal]')];
    for (const item of items) {
      item.querySelectorAll<HTMLElement>('[data-count-to]').forEach((el) => (el.textContent = '0'));
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries
          .filter((entry) => entry.isIntersecting)
          .forEach((entry, index) => {
            const item = entry.target as HTMLElement;
            const delay = index * STAGGER_MS;
            item.style.setProperty('--reveal-delay', `${delay}ms`);
            item.dataset.revealed = '';
            item.querySelectorAll<HTMLElement>('[data-count-to]').forEach((el) => countUp(el, delay));
            observer.unobserve(item);
          });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
    );
    items.forEach((item) => observer.observe(item));
  }

  document.addEventListener('astro:page-load', initReveals);
  initReveals();
</script>
