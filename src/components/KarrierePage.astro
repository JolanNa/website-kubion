---
import type { Locale } from '../config';
import { getJobs, loadPage, pageAlternates } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutHero from './AboutHero.astro';
import CtaPanel from './CtaPanel.astro';
import DraftTag from './DraftTag.astro';
import JobList from './JobList.astro';
import PhotoStrip from './PhotoStrip.astro';
import Placeholder from './Placeholder.astro';
import ScrollMotion from './ScrollMotion.astro';
import SectionHeader from './SectionHeader.astro';

/**
 * The Karriere page, built from the same parts as Über uns: hero, why work
 * here next to an image placeholder, the team photo strip, the open roles
 * (featured ones highlighted), the benefits, and a way to apply.
 *
 * Section copy comes from the `career` block of
 * src/content/pages/karriere/<locale>.mdx; the roles are the `jobs` collection.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const source = `src/content/pages/karriere/${locale}.mdx`;
const entry = await loadPage('karriere', locale);
const { hero, career } = entry.data;

if (!hero || !career) {
  throw new Error(`The Karriere page needs a \`hero\` and a \`career\` block in ${source}.`);
}

const { jobs } = career;
const openings = await getJobs(locale);
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  alternates={pageAlternates('karriere')}
  ogImage={entry.data.ogImage}
  noindex={entry.data.noindex}
>
  <ScrollMotion />

  <AboutHero hero={hero} locale={locale} source={source} />

  <section class="px-4 py-20 sm:px-16 lg:px-20 lg:py-32">
    <div class="mx-auto grid max-w-[84rem] gap-12 lg:grid-cols-2 lg:gap-20">
      <div data-scroll-reveal>
        {career.intro.kicker && <p class="kicker text-marine-70">{career.intro.kicker}</p>}
        <h2
          class="mt-6 max-w-[18ch] text-3xl leading-[1.05] font-bold tracking-[-0.02em] text-balance sm:text-5xl"
        >
          {career.intro.heading}
        </h2>
        {career.intro.draft && <DraftTag locale={locale} class="mt-5" />}
        <div class="mt-10 space-y-5 text-lg leading-relaxed text-pretty text-marine-70">
          {career.intro.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      {/* Sticks beside the text on wide screens; stands in for a photo until one is chosen. */}
      <div data-scroll-reveal class="lg:sticky lg:top-[calc(var(--header-height)+2rem)] lg:self-start">
        <Placeholder label={career.intro.imageNote} class="aspect-[4/3] w-full" />
      </div>
    </div>
  </section>

  <PhotoStrip label={career.gallery.label} items={career.gallery.items} source={source} />

  <section id="stellen" class="scroll-mt-[var(--header-height)] px-4 py-20 sm:px-16 lg:px-20 lg:py-32">
    <div class="mx-auto max-w-[84rem]">
      <div data-scroll-reveal class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeader section={jobs} locale={locale} />
        {
          jobs.email && (
            <a
              href={`mailto:${jobs.email}`}
              class="self-start font-mono text-lg text-marine underline decoration-orange decoration-2 underline-offset-[6px] transition-colors hover:text-orange lg:self-end"
            >
              {jobs.email}
            </a>
          )
        }
      </div>

      <JobList jobs={openings} locale={locale} class="mt-12 lg:mt-16" />
    </div>
  </section>

  <section class="px-4 pb-20 lg:pb-32">
    <div class="rounded-3xl bg-nebel px-6 py-16 sm:px-12 lg:px-16 lg:py-24">
      <div class="mx-auto max-w-[84rem]">
        <SectionHeader section={career.benefits} locale={locale} />

        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {
            career.benefits.items.map((item, index) => (
              <li data-scroll-reveal class="flex flex-col bg-weiss p-8 lg:p-10">
                <span class="flex items-center gap-4">
                  <span class="markenkern size-3 shrink-0" aria-hidden="true" />
                  <span class="font-mono text-sm tracking-[0.14em] text-marine-70">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                </span>
                <h3 class="mt-10 text-2xl font-semibold tracking-[-0.02em]">{item.title}</h3>
                <p class="mt-4 leading-relaxed text-pretty text-marine-70">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaPanel section={career.cta} locale={locale} source={source} />
</BaseLayout>
