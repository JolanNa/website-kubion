---
import type { Locale } from '../config';
import PageHero from './PageHero.astro';

/**
 * The Über-uns, Karriere and Projekte hero. Same layout as every other
 * subpage (see PageHero.astro); kept as its own name so those pages read
 * as before.
 */
interface Props {
  hero: {
    eyebrow?: string;
    headline: string;
    primaryCta?: { label: string; page?: string; href?: string };
    secondaryCta?: { label: string; page?: string; href?: string };
  };
  locale: Locale;
  /** The content file the hero came from, for error messages. */
  source: string;
  /** No longer changes anything; the hero headline has one size now. */
  compact?: boolean;
}

const { hero, locale, source } = Astro.props;
---

<PageHero hero={hero} locale={locale} source={source} />
