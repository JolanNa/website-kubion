---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../config';
import { isPageKey, localizedPath } from '../i18n/routes';

/**
 * The homepage hero: a full-bleed navy panel inset from the viewport edges.
 *
 * All copy comes from src/content/pages/home/<locale>.mdx frontmatter
 * (DECISIONS.md §3) — nothing here is hardcoded text. CTAs reference page KEYS
 * rather than URLs, so localised slugs resolve automatically.
 */
interface Props {
  entry: CollectionEntry<'pages'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { hero } = entry.data;

if (!hero) {
  throw new Error(
    `The homepage hero needs a \`hero\` block in src/content/pages/home/${locale}.mdx.`,
  );
}

/**
 * Resolves a CTA to a URL. A `page` key wins over a raw `href`, so localised
 * slugs stay automatic. An unknown key fails the build rather than shipping a
 * dead link.
 */
function href(cta: { page?: string; href?: string }): string {
  if (cta.page) {
    if (!isPageKey(cta.page)) {
      throw new Error(
        `Unknown page key "${cta.page}" in src/content/pages/home/${locale}.mdx.\n` +
          `Valid keys are defined in src/i18n/routes.ts.`,
      );
    }
    return localizedPath(cta.page, locale);
  }
  return cta.href ?? '#';
}
---

<section class="px-3 pb-3">
  <div
    class="relative overflow-hidden rounded-3xl bg-brand-900 px-6 py-16 sm:px-12 lg:px-16 lg:py-24"
  >
    <div class="mx-auto max-w-[84rem]">
      {
        hero.eyebrow && (
          <p class="flex items-center gap-4">
            <span class="size-5 shrink-0 bg-accent-500" aria-hidden="true" />
            <span class="label-mono text-on-brand">{hero.eyebrow}</span>
          </p>
        )
      }

      <h1
        class="mt-12 max-w-[16ch] text-[clamp(2.75rem,7.5vw,6.5rem)] leading-[0.95] font-bold tracking-[-0.03em] text-on-brand text-balance"
      >
        {hero.headline}
      </h1>

      {
        hero.subline && (
          <p class="mt-10 max-w-[34ch] text-lg leading-relaxed text-on-brand-muted sm:text-xl">
            {hero.subline}
          </p>
        )
      }

      <div class="mt-12 flex flex-wrap items-center gap-4">
        {
          hero.primaryCta && (
            <a
              href={href(hero.primaryCta)}
              class="rounded-full bg-surface px-7 py-3.5 font-medium text-brand-900 transition-transform duration-300 ease-[var(--ease-out-quint)] hover:-translate-y-0.5"
            >
              {hero.primaryCta.label}
            </a>
          )
        }
        {
          hero.secondaryCta && (
            <a
              href={href(hero.secondaryCta)}
              class="rounded-full border border-on-brand-muted/50 px-7 py-3.5 font-medium text-on-brand transition-colors duration-300 hover:border-on-brand hover:bg-white/5"
            >
              {hero.secondaryCta.label}
            </a>
          )
        }
      </div>

      {
        hero.textLink && (
          <p class="mt-8">
            <a
              href={href(hero.textLink)}
              class="group inline-flex items-center gap-2 text-on-brand-muted transition-colors duration-200 hover:text-on-brand"
            >
              {hero.textLink.label}
              <span
                class="transition-transform duration-300 ease-[var(--ease-out-quint)] group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </p>
        )
      }

      {
        hero.note && (
          <p class="mt-20 flex items-center gap-4 lg:mt-28">
            {/* Pixel heart, drawn inline so it inherits the accent token. */}
            <svg
              width="18"
              height="16"
              viewBox="0 0 9 8"
              class="shrink-0 text-accent-500"
              aria-hidden="true"
              fill="currentColor"
              shape-rendering="crispEdges"
            >
              <path
                d="M1 0h2v1H1zM6 0h2v1H6zM0 1h4v1H0zM5 1h4v1H5zM0 2h9v1H0zM0 3h9v1H0zM1 4h7v1H1zM2 5h5v1H2zM3 6h3v1H3zM4 7h1v1H4z"
              />
            </svg>
            <span class="label-mono text-on-brand">{hero.note}</span>
          </p>
        )
      }
    </div>
  </div>
</section>
