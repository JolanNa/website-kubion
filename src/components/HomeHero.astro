---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../config';
import { isPageKey, localizedPath } from '../i18n/routes';

/**
 * The homepage hero.
 *
 * Layout and shape follow the Figma design. Colour and type follow the brand
 * guideline (Marine / Orange / Hellblau, Geist Sans + Geist Mono).
 *
 * All copy comes from src/content/pages/home/<locale>.mdx frontmatter
 * (DECISIONS.md §3). CTAs reference page KEYS, so localised slugs resolve
 * automatically and a typo fails the build instead of shipping a dead link.
 */
interface Props {
  entry: CollectionEntry<'pages'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { hero } = entry.data;

if (!hero) {
  throw new Error(
    `The homepage hero needs a \`hero\` block in src/content/pages/home/${locale}.mdx.`,
  );
}

function href(cta: { page?: string; href?: string }): string {
  if (cta.page) {
    if (!isPageKey(cta.page)) {
      throw new Error(
        `Unknown page key "${cta.page}" in src/content/pages/home/${locale}.mdx.\n` +
          `Valid keys are defined in src/i18n/routes.ts.`,
      );
    }
    return localizedPath(cta.page, locale);
  }
  return cta.href ?? '#';
}
---

<section class="px-4 pb-4">
  {/*
    The panel fills the viewport below the sticky header, so the whole of it is
    visible without scrolling.

    `min-h` rather than `h`: on a viewport too short for the content the panel
    grows instead of clipping it. `100svh` is the SMALL viewport height — the
    height when mobile browser chrome is expanded — so the panel still fits when
    the address bar is showing, which `100vh` would not guarantee.

    The subtraction is the header plus this section's own bottom padding.

    The vertical rhythm inside is expressed in `svh` as well as rem, so a wide
    but short window (a laptop with browser chrome, say) scales the type and
    spacing down rather than overflowing. `svh` not `dvh`: dvh changes as mobile
    chrome hides on scroll, which would resize the headline mid-scroll.
  */}
  <div
    class="relative flex min-h-[calc(100svh-var(--header-height)-(--spacing(4)))] flex-col overflow-hidden rounded-3xl bg-marine px-6 py-[clamp(2rem,7svh,6rem)] sm:px-12 lg:px-16"
  >
    <div class="mx-auto flex w-full max-w-[84rem] flex-1 flex-col">
      {
        hero.eyebrow && (
          <p class="flex items-center gap-4">
            {/* Markenkern — square, 135° gradient, no radius (Guideline §05). */}
            <span class="markenkern size-7 shrink-0" aria-hidden="true" />
            <span class="kicker text-weiss">{hero.eyebrow}</span>
          </p>
        )
      }

      <h1
        class="mt-[clamp(1.5rem,4svh,3rem)] max-w-[16ch] text-[clamp(2.25rem,min(7.5vw,10svh),6.5rem)] leading-[0.95] font-bold tracking-[-0.03em] text-weiss text-balance"
      >
        {hero.headline}
      </h1>

      {
        hero.subline && (
          <p class="mt-[clamp(1rem,3svh,2.5rem)] max-w-[34ch] text-lg leading-relaxed text-hellblau sm:text-xl">
            {hero.subline}
          </p>
        )
      }

      <div class="mt-[clamp(1.5rem,4svh,3rem)] flex flex-wrap items-center gap-4">
        {
          hero.primaryCta && (
            <a
              href={href(hero.primaryCta)}
              class="rounded-full bg-weiss px-7 py-3.5 font-medium text-marine transition-transform duration-300 ease-[var(--ease-out-quint)] hover:-translate-y-0.5"
            >
              {hero.primaryCta.label}
            </a>
          )
        }
        {
          hero.secondaryCta && (
            <a
              href={href(hero.secondaryCta)}
              class="rounded-full border border-hellblau/50 px-7 py-3.5 font-medium text-weiss transition-colors duration-300 hover:border-hellblau hover:bg-white/5"
            >
              {hero.secondaryCta.label}
            </a>
          )
        }
      </div>

      {
        hero.textLink && (
          <p class="mt-[clamp(1rem,2.5svh,2rem)]">
            <a
              href={href(hero.textLink)}
              class="group inline-flex items-center gap-2 text-hellblau transition-colors duration-200 hover:text-weiss"
            >
              {hero.textLink.label}
              <span
                class="transition-transform duration-300 ease-[var(--ease-out-quint)] group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </p>
        )
      }

      {
        hero.note && (
          <p class="mt-auto flex items-center gap-4 pt-[clamp(1.5rem,5svh,4rem)]">
            {/* Pixel heart, drawn inline so it inherits the accent colour. */}
            <svg
              width="18"
              height="16"
              viewBox="0 0 9 8"
              class="shrink-0 text-orange"
              aria-hidden="true"
              fill="currentColor"
              shape-rendering="crispEdges"
            >
              <path
                d="M1 0h2v1H1zM6 0h2v1H6zM0 1h4v1H0zM5 1h4v1H5zM0 2h9v1H0zM0 3h9v1H0zM1 4h7v1H1zM2 5h5v1H2zM3 6h3v1H3zM4 7h1v1H4z"
              />
            </svg>
            <span class="kicker text-weiss">{hero.note}</span>
          </p>
        )
      }
    </div>
  </div>
</section>
