---
import { render } from 'astro:content';
import type { Locale } from '../config';
import type { PageKey } from '../i18n/routes';
import { loadPage, pageAlternates } from '../lib/content';
import { resolveImage } from '../lib/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { Image } from 'astro:assets';

/**
 * Renders a Tier 1 static marketing page (DECISIONS.md §3).
 *
 * Each route in src/pages/ is a four-line file that delegates here, so the routing
 * table stays explicit — necessary because slugs are localised and can't be derived.
 */
interface Props {
  pageKey: PageKey;
  locale: Locale;
}

const { pageKey, locale } = Astro.props;

const entry = await loadPage(pageKey, locale);
const { Content } = await render(entry);
const { hero } = entry.data;
const heroImage = resolveImage(hero?.image);
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  alternates={pageAlternates(pageKey)}
  ogImage={entry.data.ogImage}
  noindex={entry.data.noindex}
>
  {/* Pages without a hero in their content (Impressum, Datenschutz) still get one, titled after the page. */}
  <PageHero
    hero={{
      headline: hero?.headline ?? entry.data.title,
      intro: hero?.subline,
      primaryCta: hero?.ctaLabel && hero?.ctaHref ? { label: hero.ctaLabel, href: hero.ctaHref } : undefined,
    }}
    locale={locale}
    source={`src/content/pages/${entry.id}.mdx`}
  />
  {
    heroImage && (
      <div class="px-4 pb-12 sm:px-16 lg:px-20">
        <Image
          src={heroImage}
          alt=""
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1024px) 1024px, 100vw"
          class="mx-auto w-full max-w-[84rem] rounded-2xl"
          loading="eager"
        />
      </div>
    )
  }

  <div class="px-4 pb-20 sm:px-16 lg:px-20 lg:pb-32">
    <div class="mx-auto max-w-[84rem]">
      <div class="prose max-w-3xl">
        <Content />
      </div>
    </div>
  </div>

  <slot />
</BaseLayout>
