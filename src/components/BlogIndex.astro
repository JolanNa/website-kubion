---
import type { Locale } from '../config';
import { getPosts, pageAlternates, postPath } from '../lib/content';
import { resolveImage } from '../lib/images';
import { useTranslations } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = await getPosts(locale);

const dateFormat = new Intl.DateTimeFormat(locale === 'de' ? 'de-DE' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  locale={locale}
  title={t('blog.title')}
  description={t('blog.title')}
  alternates={pageAlternates('blog')}
>
  <div class="mx-auto max-w-6xl px-4 py-20">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{t('blog.title')}</h1>

    {posts.length === 0 && <p class="mt-8 text-neutral-600">{t('blog.empty')}</p>}

    <ul class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => {
          const image = resolveImage(post.data.heroImage);
          return (
            <li>
              <a href={postPath(post, locale)} class="group block">
                {image && (
                  <Image
                    src={image}
                    alt={post.data.heroImageAlt ?? ''}
                    widths={[400, 800]}
                    sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
                    class="mb-4 aspect-[3/2] w-full rounded-xl object-cover"
                    loading="lazy"
                  />
                )}
                <time
                  datetime={post.data.publishedAt.toISOString()}
                  class="text-sm text-neutral-500"
                >
                  {dateFormat.format(post.data.publishedAt)}
                </time>
                <h2 class="mt-2 text-xl font-semibold tracking-tight group-hover:underline underline-offset-4">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-neutral-600">{post.data.description}</p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</BaseLayout>
