---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../config';
import { ctaHref } from '../lib/content';
import { CANVAS, PARTS, layers, tags, type Part } from '../lib/visionScene';
import ArrowLink from './ArrowLink.astro';
import Placeholder from './Placeholder.astro';
import SectionHeader from './SectionHeader.astro';

/**
 * A vision system, taken apart: an isometric scene that stays pinned while the
 * section scrolls. It starts assembled, comes apart as the first part scrolls
 * in, and then each part is singled out while its text is on screen. All the
 * while the belt runs with the scroll: products pass under the camera, the odd
 * one out is found and pushed off the line.
 *
 * Each item names the `part` of the scene it describes, and may carry a photo
 * of us working on that part (`imageNote` until the photo exists). The artwork
 * is a placeholder drawn in src/lib/visionScene.ts.
 *
 * Without JS the scene simply renders apart and every text is fully visible;
 * with reduced motion the parts are still singled out, but nothing travels.
 */
interface Props {
  id: string;
  section: CollectionEntry<'pages'>['data']['sections'][string];
  locale: Locale;
  /** The MDX file the section comes from, for error messages. */
  source: string;
}

const { id, section, locale, source } = Astro.props;

for (const item of section.items) {
  if (!PARTS.includes(item.part as Part)) {
    throw new Error(
      `"${item.title}" in ${source} needs a \`part\`: one of ${PARTS.join(', ')}.`,
    );
  }
}

const viewBox = `${CANVAS.x} ${CANVAS.y} ${CANVAS.width} ${CANVAS.height}`;
const number = (index: number) => String(index + 1).padStart(2, '0');

/** Canvas units as percentages of the canvas, which is what the CSS works in. */
const percent = {
  x: (value: number) => (value / CANVAS.width) * 100,
  y: (value: number) => (value / CANVAS.height) * 100,
};
---

<section id={id} class="scroll-mt-28 px-4 py-14 sm:px-16 lg:px-20 lg:py-24" data-vision>
  <div class="mx-auto max-w-[84rem] lg:grid lg:grid-cols-[1fr_1.15fr] lg:gap-x-16">
    <div class="lg:flex lg:min-h-[78vh] lg:flex-col lg:justify-center lg:pb-24">
      <SectionHeader section={section} locale={locale} />
      {
        section.primaryCta && (
          <ArrowLink href={ctaHref(section.primaryCta, locale, source)} class="mt-10">
            {section.primaryCta.label}
          </ArrowLink>
        )
      }
    </div>

    <!-- On small screens the scene pins under the header and the texts scroll
         past beneath it; from lg it pins beside them. -->
    <div
      class="sticky top-0 z-10 mt-10 bg-weiss pt-(--header-height) pb-4 lg:top-(--header-height) lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:self-start lg:py-0"
      aria-hidden="true"
    >
      <div
        class="stage relative h-[42svh] overflow-hidden rounded-3xl bg-nebel lg:h-[calc(100svh-var(--header-height)-2rem)]"
      >
        <div
          class="canvas"
          style={`--ratio:${CANVAS.width / CANVAS.height}`}
          data-vision-canvas
        >
          {
            layers.map((layer) => (
              <svg
                class="layer"
                viewBox={viewBox}
                style={`--dx:${percent.x(layer.dx)};--dy:${percent.y(layer.dy)}`}
                data-vision-layer={layer.part}
                set:html={layer.svg}
              />
            ))
          }
          {
            section.items.map((item, index) => {
              const tag = tags[item.part as Part];
              return (
                <span
                  class="tag kicker hidden items-center gap-2 rounded-full bg-marine py-1 pr-3 pl-2 whitespace-nowrap text-weiss shadow-island lg:flex"
                  style={`--x:${percent.x(tag.x - CANVAS.x)};--y:${percent.y(tag.y - CANVAS.y)};--dx:${percent.x(tag.dx)};--dy:${percent.y(tag.dy)}`}
                  data-vision-tag={item.part}
                >
                  <span class="size-1.5 rounded-full bg-orange" />
                  {number(index)} {item.title}
                </span>
              );
            })
          }
        </div>
        {
          section.imageNote && (
            <span class="kicker absolute top-4 left-4 rounded-full bg-weiss px-3 py-1 text-marine-70">
              {section.imageNote}
            </span>
          )
        }
      </div>
    </div>

    <ol class="pt-6 lg:pt-0">
      {
        section.items.map((item, index) => (
          <li class="step flex min-h-[38svh] gap-5 py-6 lg:min-h-[50vh] lg:py-0" data-vision-step={item.part}>
            {/* The number, and a line down to the next one. */}
            <span class="flex flex-col items-center">
              <span class="kicker flex size-9 shrink-0 items-center justify-center rounded-lg bg-marine text-weiss">
                {number(index)}
              </span>
              {index < section.items.length - 1 && <span class="mt-3 w-px flex-1 bg-marine-15 lg:mb-3" />}
            </span>
            <div class="flex-1 lg:pb-20">
              {item.meta && <p class="kicker text-marine-70">{item.meta}</p>}
              <h3 class="mt-2 text-2xl font-semibold tracking-[-0.01em] sm:text-3xl">{item.title}</h3>
              {
                item.text && (
                  <p class="mt-3 max-w-[46ch] text-lg leading-relaxed text-pretty text-marine-70">
                    {item.text}
                  </p>
                )
              }
              {
                item.imageNote && (
                  <Placeholder
                    label={item.imageNote}
                    class="mt-6 aspect-[16/9] w-full max-w-[30rem] rounded-2xl p-6 text-center"
                  />
                )
              }
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .stage {
    container-type: size;
  }

  /*
   * The canvas keeps the scene's aspect ratio and fits the stage. --explode
   * runs from 0 (assembled) to 1 (apart); the script drives it from the scroll
   * position. Assembled, the scene is a little larger, since it needs less room.
   */
  .canvas {
    --explode: 1;
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(100cqw - 2rem, (100cqh - 2rem) * var(--ratio));
    aspect-ratio: var(--ratio);
    translate: -50% -50%;
    scale: calc(1.12 - 0.12 * var(--explode));
    transition: scale 300ms ease-out;
  }

  /* Travel is stored as a percentage of the canvas, so it scales with it. */
  .layer {
    position: absolute;
    inset: 0;
    overflow: visible;
    transform: translate(
      calc(var(--dx) * var(--explode) * 1%),
      calc(var(--dy) * var(--explode) * 1%)
    );
    transition:
      transform 300ms ease-out,
      opacity 450ms ease-out,
      filter 450ms ease-out;
  }

  .layer.is-dim {
    opacity: 0.14;
    filter: grayscale(1);
  }

  /* The part in question lifts off the ground a little. */
  .layer.is-active {
    filter: drop-shadow(0 1rem 0.9rem color-mix(in srgb, var(--color-marine) 24%, transparent));
  }

  /* The artwork is injected markup, so its classes are not scoped. */
  .layer :global(.beam) {
    transition: opacity 450ms ease-out;
  }

  .layer.is-active :global(.beam) {
    opacity: 1;
  }

  /* A name tag just above the part, travelling with it. Only beside the texts:
     under the pinned scene on small screens it would be wider than the part. */
  .tag {
    position: absolute;
    --at: calc(var(--x) + var(--dx) * var(--explode));
    left: calc(var(--at) * 1%);
    top: calc((var(--y) + var(--dy) * var(--explode)) * 1%);
    /* Shifted back by as much of its own width as it sits across the canvas,
       so it never leaves it: flush left at the left edge, flush right at the right. */
    translate: calc(var(--at) * -1%) -100%;
    opacity: 0;
    transition: opacity 300ms ease-out;
  }

  .tag.is-active {
    opacity: 1;
  }

  /* Only once the script runs: with no JS every text stays fully visible. */
  [data-vision-ready] .step {
    opacity: 0.3;
    transition: opacity 450ms ease-out;
  }

  [data-vision-ready] .step.is-active {
    opacity: 1;
  }
</style>

<script>
  import { productPose } from '../lib/visionBelt';

  /** Scroll distance, in pixels, that moves the belt on by one product. */
  const BELT_PACE = 240;

  /**
   * Drives the scene from the scroll position. Initialised the same way as
   * Header.astro.
   *
   * A step becomes active once its top crosses the trigger line; the scene
   * comes apart over the stretch just before the first step gets there. The
   * belt moves with every pixel scrolled while the section is on screen.
   */
  function initVisionSystems() {
    for (const root of document.querySelectorAll<HTMLElement>('[data-vision]')) {
      const canvas = root.querySelector<HTMLElement>('[data-vision-canvas]');
      const steps = [...root.querySelectorAll<HTMLElement>('[data-vision-step]')];
      const layers = [...root.querySelectorAll<SVGElement>('[data-vision-layer]')];
      const tags = [...root.querySelectorAll<HTMLElement>('[data-vision-tag]')];
      const products = [...root.querySelectorAll<SVGGElement>('[data-vision-product]')];
      if (!canvas || steps.length === 0 || root.dataset.visionReady) continue;
      root.dataset.visionReady = 'true';

      const stage = canvas.parentElement!;
      const desktop = window.matchMedia('(min-width: 64rem)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let frame = 0;

      function update() {
        frame = 0;
        if (!root.isConnected) {
          window.removeEventListener('scroll', request);
          window.removeEventListener('resize', request);
          return;
        }

        // Beside the scene the line sits low in the viewport; under it, in the
        // space the scene leaves free.
        const viewport = window.innerHeight;
        const below = stage.getBoundingClientRect().bottom;
        const line = desktop.matches ? viewport * 0.65 : below + (viewport - below) * 0.6;

        const tops = steps.map((step) => step.getBoundingClientRect().top);
        const active = tops.findLastIndex((top) => top <= line);
        const part = steps[active]?.dataset.visionStep;

        const travel = viewport * 0.35;
        const explode = Math.min(1, Math.max(0, (line + travel - tops[0]) / travel));
        canvas!.style.setProperty('--explode', reducedMotion.matches ? '1' : explode.toFixed(3));

        steps.forEach((step, index) => step.classList.toggle('is-active', index === active));
        for (const layer of layers) {
          layer.classList.toggle('is-dim', !!part && layer.dataset.visionLayer !== part);
          layer.classList.toggle('is-active', layer.dataset.visionLayer === part);
        }
        for (const tag of tags) tag.classList.toggle('is-active', tag.dataset.visionTag === part);

        const entered = viewport - root.getBoundingClientRect().top;
        const belt = reducedMotion.matches ? 0 : Math.max(0, entered / BELT_PACE);
        products.forEach((product, slot) => {
          const pose = productPose(slot, belt);
          product.style.transform = `translate(${pose.x.toFixed(1)}px, ${pose.y.toFixed(1)}px)`;
          product.style.opacity = pose.opacity.toFixed(2);
          for (const look of product.children as HTMLCollectionOf<SVGGElement>) {
            look.style.display = look.dataset.look === pose.state ? '' : 'none';
          }
        });
      }

      function request() {
        frame ||= requestAnimationFrame(update);
      }

      window.addEventListener('scroll', request, { passive: true });
      window.addEventListener('resize', request);
      update();
    }
  }

  document.addEventListener('astro:page-load', initVisionSystems);
  initVisionSystems();
</script>
