---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { Locale } from '../config';
import { localizedPath } from '../i18n/routes';
import { resolveImage } from '../lib/images';
import { useTranslations } from '../i18n/ui';

/**
 * The compact box beside a blog article: a round portrait, name, role, short bio and
 * contact links of the post's author, then the other team members who worked
 * on the project. Both come from the CMS-managed team collection.
 */
interface Props {
  member: CollectionEntry<'team'>;
  contributors?: CollectionEntry<'team'>[];
  locale: Locale;
  class?: string;
}

const { member, contributors = [], locale, class: className } = Astro.props;
const t = useTranslations(locale);

const { Content } = await render(member);
const photo = resolveImage(member.data.photo);

/** Stands in for the portrait until a photo is uploaded. */
function initials(name: string): string {
  const parts = name.trim().split(/\s+/);
  return [parts[0], parts.length > 1 ? parts.at(-1) : undefined]
    .map((part) => part?.[0] ?? '')
    .join('')
    .toUpperCase();
}
---

<aside class:list={['rounded-2xl bg-nebel p-5', className]} aria-label={t('blog.author')}>
  <p class="flex items-center gap-3">
    <span class="markenkern size-2.5 shrink-0" aria-hidden="true" />
    <span class="kicker text-marine-70">{t('blog.author')}</span>
  </p>

  <div class="mt-4 flex items-center gap-4">
    {
      photo ? (
        <Image
          src={photo}
          alt=""
          widths={[128, 256]}
          sizes="4rem"
          class="size-16 shrink-0 rounded-full object-cover"
          loading="lazy"
        />
      ) : (
        <span
          class="flex size-16 shrink-0 items-center justify-center rounded-full bg-hellblau font-mono tracking-[0.14em]"
          aria-hidden="true"
        >
          {initials(member.data.name)}
        </span>
      )
    }
    <span>
      <span class="block text-lg leading-tight font-bold tracking-[-0.02em]">{member.data.name}</span>
      <span class="kicker mt-1.5 block text-marine-70">{member.data.role}</span>
    </span>
  </div>

    <div class="mt-4 text-sm leading-relaxed text-pretty text-marine-70 [&_p+p]:mt-3">
      <Content />
    </div>

    <div class="mt-5 flex flex-wrap gap-2">
      {
        member.data.email && (
          <a
            href={`mailto:${member.data.email}`}
            class="rounded-full bg-marine px-4 py-2 text-sm font-medium text-weiss transition-transform duration-300 ease-[var(--ease-out-quint)] hover:-translate-y-0.5"
          >
            {t('form.email')}
          </a>
        )
      }
      {
        member.data.linkedin && (
          <a
            href={member.data.linkedin}
            rel="noopener"
            class="rounded-full border border-marine-15 px-4 py-2 text-sm font-medium transition-colors hover:border-marine"
          >
            LinkedIn
          </a>
        )
      }
      {
        !member.data.email && (
          <a
            href={localizedPath('kontakt', locale)}
            class="rounded-full bg-marine px-4 py-2 text-sm font-medium text-weiss transition-transform duration-300 ease-[var(--ease-out-quint)] hover:-translate-y-0.5"
          >
            {t('blog.contact')}
          </a>
        )
      }
    </div>

    {
      contributors.length > 0 && (
        <div class="mt-6 border-t border-marine-15 pt-5">
          <p class="kicker text-marine-70">{t('blog.contributors')}</p>
          <ul class="mt-3 space-y-3">
            {contributors.map((person) => {
              const portrait = resolveImage(person.data.photo);
              return (
                <li class="flex items-center gap-3">
                  {portrait ? (
                    <Image
                      src={portrait}
                      alt=""
                      widths={[80]}
                      sizes="2.5rem"
                      class="size-10 rounded-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <span
                      class="flex size-10 items-center justify-center rounded-full bg-hellblau font-mono text-xs"
                      aria-hidden="true"
                    >
                      {initials(person.data.name)}
                    </span>
                  )}
                  <span>
                    <span class="block text-sm font-semibold">{person.data.name}</span>
                    <span class="block text-xs text-marine-70">{person.data.role}</span>
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
</aside>
