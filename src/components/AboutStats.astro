---
import type { Locale } from '../config';
import DraftTag from './DraftTag.astro';

/**
 * The key figures: three large numbers that count up from zero, one after the
 * other, when the row scrolls in.
 *
 * The markup holds the final values, so the row is complete without script and
 * with reduced motion; the script only rewinds and replays it when motion is
 * allowed.
 */
interface Props {
  stats: {
    draft?: boolean;
    kicker?: string;
    items: { value: number; suffix: string; label: string }[];
  };
  locale: Locale;
}

const { stats, locale } = Astro.props;
const numberFormat = new Intl.NumberFormat(locale === 'de' ? 'de-DE' : 'en-GB');
---

<section class="px-4 pb-20 sm:px-16 lg:px-20 lg:pb-32" data-stats>
  <div class="mx-auto max-w-[84rem]">
    <div class="flex flex-wrap items-center gap-4">
      {stats.kicker && <p class="kicker text-marine-70">{stats.kicker}</p>}
      {stats.draft && <DraftTag locale={locale} />}
    </div>
    <dl class="mt-8 grid border-t border-marine-15 sm:grid-cols-3">
      {
        stats.items.map((stat) => (
          <div class="flex flex-col-reverse border-b border-marine-15 py-8 sm:border-b-0 sm:border-l sm:py-12 sm:pl-8 sm:first:border-l-0 sm:first:pl-0">
            <dt class="mt-3 text-lg font-medium text-marine-70">{stat.label}</dt>
            <dd class="text-[clamp(4rem,9vw,8.5rem)] leading-[0.9] font-black tracking-[-0.04em] tabular-nums">
              {/* The animated figure is decorative; screen readers get the final value. */}
              <span class="sr-only">{`${numberFormat.format(stat.value)}${stat.suffix}`}</span>
              <span aria-hidden="true">
                <span data-count-to={stat.value}>{numberFormat.format(stat.value)}</span>
                {stat.suffix && <span class="text-orange">{stat.suffix}</span>}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  /**
   * Rewinds the figures to zero and counts them up, staggered, when the row
   * scrolls in. Skipped with reduced motion — the markup is already the final
   * state. Initialised directly and on `astro:page-load` (DECISIONS.md §12).
   */
  const COUNT_MS = 1600;
  const STAGGER_MS = 140;

  function countUp(el: HTMLElement, delay: number) {
    const target = Number(el.dataset.countTo);
    const format = new Intl.NumberFormat(document.documentElement.lang || 'de');
    const easeOutQuint = (t: number) => 1 - Math.pow(1 - t, 5);
    let start: number | undefined;

    const step = (now: number) => {
      start ??= now + delay;
      const t = Math.min(Math.max((now - start) / COUNT_MS, 0), 1);
      el.textContent = format.format(Math.round(target * easeOutQuint(t)));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  function initStats() {
    const section = document.querySelector<HTMLElement>('[data-stats]');
    if (!section || section.dataset.bound) return;
    section.dataset.bound = 'true';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const figures = [...section.querySelectorAll<HTMLElement>('[data-count-to]')];
    figures.forEach((el) => (el.textContent = '0'));

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        figures.forEach((el, i) => countUp(el, i * STAGGER_MS));
        observer.disconnect();
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    observer.observe(section.querySelector('dl')!);
  }

  document.addEventListener('astro:page-load', initStats);
  initStats();
</script>
