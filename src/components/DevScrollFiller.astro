---
import type { Locale } from '../config';

/**
 * ⚠️ TEMPORARY — placeholder sections below the hero, so the page scrolls.
 *
 * Exists only so scroll-dependent behaviour can be exercised: the header
 * hairline that fades in on scroll, and the scroll-driven animation still to
 * come (DECISIONS.md §12).
 *
 * DELETE THIS FILE, and its use in src/pages/index.astro and
 * src/pages/en/index.astro, once the real homepage sections are built. It is
 * listed in LAUNCH-CHECKLIST.md so it cannot ship by accident.
 *
 * Strings are kept local rather than added to src/i18n/ui.ts — nothing
 * throwaway should end up in the real translation dictionary.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const COPY = {
  de: {
    clientsKicker: 'Im Einsatz bei',
    projectsKicker: 'Unsere Projekte',
    projectsHeadline: 'Von der Idee bis in den Produktivbetrieb.',
    projects: [
      'Bioabfall-Störstoffanalyse',
      'Dokumentenerkennung im Druckprozess',
      'Prognosen aus Produktionsdaten',
    ],
    approachKicker: 'Platzhalter',
    approachHeadline: 'Dieser Abschnitt ist Blindtext.',
    body: [
      'Dieser Text steht hier nur, damit die Seite scrollt. Er wird ersetzt, sobald die echten Abschnitte gestaltet sind.',
      'Die Reihenfolge, die Abstände und die Farbwechsel zwischen hellen und dunklen Bereichen sind bewusst grob gehalten — sie sind kein Gestaltungsvorschlag.',
      'Bis dahin dient der Bereich dazu, das Verhalten der Navigation beim Scrollen zu prüfen.',
    ],
  },
  en: {
    clientsKicker: 'Trusted by',
    projectsKicker: 'Our projects',
    projectsHeadline: 'From first idea to production.',
    projects: [
      'Bio-waste contaminant analysis',
      'Document recognition in print',
      'Forecasting from production data',
    ],
    approachKicker: 'Placeholder',
    approachHeadline: 'This section is dummy copy.',
    body: [
      'This text exists only so the page scrolls. It will be replaced once the real sections are designed.',
      'The order, the spacing and the alternation between light and dark areas are deliberately rough — they are not a design proposal.',
      'Until then this area serves to exercise the navigation behaviour on scroll.',
    ],
  },
} as const satisfies Record<Locale, unknown>;

const t = COPY[locale];

/** Hatched fill, so a placeholder never reads as a real logo or image. */
const hatch =
  'repeating-linear-gradient(135deg, var(--color-nebel) 0 8px, var(--color-marine-15) 8px 16px)';
---

<!-- TEMPORARY placeholder sections — see DevScrollFiller.astro -->
<div data-dev-filler>
  <section class="mx-auto max-w-[90rem] px-6 py-16">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:gap-16">
      <p class="kicker shrink-0 text-marine-45">{t.clientsKicker}</p>
      <ul class="grid flex-1 grid-cols-2 gap-6 sm:grid-cols-4">
        {
          Array.from({ length: 4 }).map(() => (
            <li class="h-10 rounded-sm" style={`background-image:${hatch}`} aria-hidden="true" />
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-[90rem] px-6 py-16">
    <p class="kicker text-marine-45">{t.projectsKicker}</p>
    <h2 class="mt-6 max-w-[18ch] text-4xl font-bold tracking-[-0.02em] text-marine sm:text-5xl">
      {t.projectsHeadline}
    </h2>

    <ul class="mt-16 grid gap-6 md:grid-cols-3">
      {
        t.projects.map((title) => (
          <li class="rounded-2xl bg-nebel p-4">
            <div
              class="aspect-[4/3] w-full rounded-xl"
              style={`background-image:${hatch}`}
              aria-hidden="true"
            />
            <p class="mt-6 mb-2 px-2 text-lg font-semibold text-marine">{title}</p>
            <p class="mb-2 px-2 text-sm text-marine-70">Platzhalter</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="bg-nebel">
    <div class="mx-auto max-w-[90rem] px-6 py-16">
      <p class="kicker text-marine-45">{t.approachKicker}</p>
      <h2 class="mt-6 max-w-[20ch] text-3xl font-bold tracking-[-0.02em] text-marine sm:text-4xl">
        {t.approachHeadline}
      </h2>
      <div class="mt-10 grid gap-10 md:grid-cols-3">
        {
          t.body.map((paragraph) => (
            <p class="leading-relaxed text-marine-70">{paragraph}</p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[90rem] px-6 py-16">
    <div class="grid gap-10 md:grid-cols-2">
      {
        Array.from({ length: 4 }).map((_, index) => (
          <div class="rounded-2xl border border-marine-15 p-10">
            <p class="kicker text-marine-45">{String(index + 1).padStart(2, '0')}</p>
            <p class="mt-4 text-xl font-semibold text-marine">{t.approachHeadline}</p>
            <p class="mt-4 leading-relaxed text-marine-70">{t.body[index % t.body.length]}</p>
          </div>
        ))
      }
    </div>
  </section>
</div>
