---
/** A text link led by the small gradient arrow tile used across the site. */
interface Props {
  href: string;
  /** On a Marine ground. */
  dark?: boolean;
  class?: string;
}

const { href, dark = false, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group/cta inline-flex items-center gap-3 font-medium',
    dark ? 'text-weiss' : 'text-marine',
    className,
  ]}
>
  <span
    class="flex size-9 shrink-0 items-center justify-center rounded-lg gradient-orange text-weiss transition-transform duration-300 ease-[var(--ease-out-quint)] group-hover/cta:translate-x-1"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M3 8h9m0 0-3.5-3.5M12 8l-3.5 3.5"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
  <slot />
</a>
