---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { Locale } from '../config';
import { projektAlternates } from '../lib/content';
import { requireImage } from '../lib/images';
import { useTranslations } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Projects are bespoke by design (DECISIONS.md §3): this component provides the
 * shell (hero, meta, gallery) and the MDX body is free to compose whatever custom
 * components a given project needs.
 */
interface Props {
  entry: CollectionEntry<'projekte'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = useTranslations(locale);

const { Content } = await render(entry);
const alternates = await projektAlternates(entry);
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  alternates={alternates}
  ogImage={entry.data.ogImage}
  noindex={entry.data.noindex}
>
  <article>
    <header class="mx-auto max-w-6xl px-4 py-20">
      <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        {entry.data.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-neutral-600 text-pretty">
        {entry.data.description}
      </p>

      <dl class="mt-10 grid gap-6 text-sm sm:grid-cols-3">
        <div>
          <dt class="text-neutral-500">{t('projekte.client')}</dt>
          <dd class="mt-1 font-medium">{entry.data.client}</dd>
        </div>
        <div>
          <dt class="text-neutral-500">{t('projekte.year')}</dt>
          <dd class="mt-1 font-medium">{entry.data.year}</dd>
        </div>
        {
          entry.data.services.length > 0 && (
            <div>
              <dt class="text-neutral-500">{t('projekte.services')}</dt>
              <dd class="mt-1 font-medium">{entry.data.services.join(', ')}</dd>
            </div>
          )
        }
      </dl>

      <Image
        src={requireImage(entry.data.heroImage, `projekte/${entry.id}`)}
        alt={entry.data.heroImageAlt}
        widths={[640, 1280, 1920]}
        sizes="(min-width: 1152px) 1152px, 100vw"
        class="mt-12 w-full rounded-2xl"
        loading="eager"
      />
    </header>

    <div class="prose mx-auto max-w-3xl px-4">
      <Content />
    </div>

    {
      entry.data.gallery.length > 0 && (
        <ul class="mx-auto mt-16 grid max-w-6xl gap-6 px-4 sm:grid-cols-2">
          {entry.data.gallery.map((item) => (
            <li>
              <Image
                src={requireImage(item.src, `projekte/${entry.id} gallery`)}
                alt={item.alt}
                widths={[600, 1200]}
                sizes="(min-width: 640px) 50vw, 100vw"
                class="w-full rounded-xl"
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>
