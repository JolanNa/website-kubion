---
import { SITE_NAME } from '../config';
import { WORDMARK_PATH, WORDMARK_VIEWBOX } from '../lib/wordmark';

/**
 * The kubion wordmark (Brand Guideline §08).
 *
 * The mark is drawn, never typeset — so this is the supplied SVG path, not the
 * word set in Geist. The source file is kept at
 * src/assets/brand/kubion-wortmarke.svg for provenance; it is inlined here so
 * CSS can colour it and so it costs no extra request.
 *
 * Rules encoded below:
 *  - Two colour versions only: white on marine, marine on light. The fill is
 *    `currentColor`, so the colour comes from the parent's text colour.
 *  - NEVER orange, and never with an outline, shadow or gradient.
 *  - Minimum digital width 90px — hence the 104px default.
 *  - Clear space on all sides = the height of the "k" (~65% of the mark's
 *    height). Callers must not crowd it.
 */
interface Props {
  /** Rendered width in px. Must not go below the 90px minimum. */
  width?: number;
  class?: string;
}

const { width = 104, class: className } = Astro.props;

// Intrinsic aspect ratio of the supplied artwork (1985 × 620).
const ASPECT = 1985 / 620;
const height = Math.round((width / ASPECT) * 100) / 100;

if (width < 90) {
  throw new Error(
    `The kubion wordmark may not be rendered below 90px wide (got ${width}px).\n` +
      `Brand Guideline §08: "Mindestbreite digital: 90 px." Use the icon instead ` +
      `where the space is narrower.`,
  );
}
---

<svg
  width={width}
  height={height}
  viewBox={WORDMARK_VIEWBOX}
  fill="none"
  role="img"
  aria-label={SITE_NAME}
  class={className}
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    fill="currentColor"
    d={WORDMARK_PATH}
  ></path>
</svg>
