---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../config';
import { ctaHref } from '../lib/content';
import { READINGS, type Reading } from '../lib/visionTasks';
import ArrowLink from './ArrowLink.astro';
import SectionHeader from './SectionHeader.astro';
import TaskScene from './TaskScene.astro';

/**
 * The kinds of problem a vision system solves. Each task is shown on a single
 * part (TaskScene.astro), one task at a time, on a large Marine ground.
 *
 * Three designs are up for review, picked by the section's `variant`:
 *
 *   a  Copy beside the part, a row of switches underneath. Plays by itself.
 *   b  A belt across the frame that runs with the scroll: the section pins,
 *      and each stretch of scrolling brings the next part into the camera's
 *      field. Its CTA is a plain line underneath.
 *   c  Five strips side by side; the open one shows its task. No autoplay.
 *
 * Each item names the task it describes as its `part`. In (a) and (c) the
 * section's CTA sits in a dashed box — the empty slot for the visitor's own task.
 *
 * Without JS the first task is shown; with reduced motion nothing plays by
 * itself and the belt in (b) jumps from part to part instead of travelling.
 */
interface Props {
  id: string;
  section: CollectionEntry<'pages'>['data']['sections'][string];
  locale: Locale;
  /** The MDX file the section comes from, for error messages. */
  source: string;
}

const { id, section, locale, source } = Astro.props;
const variant = section.variant ?? 'a';

for (const item of section.items) {
  if (!READINGS.includes(item.part as Reading)) {
    throw new Error(`"${item.title}" in ${source} needs a \`part\`: one of ${READINGS.join(', ')}.`);
  }
}

const items = section.items.map((item) => ({ ...item, part: item.part as Reading }));
const number = (index: number) => String(index + 1).padStart(2, '0');
const cta = section.primaryCta;
---

<section id={id} class="scroll-mt-28 px-4 py-14 sm:px-16 lg:px-20 lg:py-24" data-tasks={variant}>
  <div class="mx-auto max-w-[84rem]">
    <SectionHeader section={section} locale={locale} />

    {
      variant === 'a' && (
        <div class="mt-12 overflow-hidden rounded-3xl bg-marine lg:mt-16 lg:grid lg:grid-cols-[1fr_1.2fr]">
          <div class="belt relative grid place-items-center px-6 py-10 lg:order-2" data-tasks-image>
            {items.map((item, index) => (
              <TaskScene
                reading={item.part}
                class:list={['scene relative w-full max-w-[30rem]', index === 0 && 'is-active']}
                data-tasks-for={item.part}
              />
            ))}
          </div>
          {/* Every caption sits in the same cell, so the frame keeps one height. */}
          <div class="grid content-center px-6 pb-8 sm:px-10 lg:py-10">
            {items.map((item, index) => (
              <div class:list={['caption', index === 0 && 'is-active']} data-tasks-for={item.part}>
                {item.meta && <p class="kicker text-hellblau">{item.meta}</p>}
                <h3 class="mt-3 text-3xl font-semibold tracking-[-0.02em] text-weiss sm:text-4xl">{item.title}</h3>
                {item.text && (
                  <p class="mt-4 max-w-[40ch] text-lg leading-relaxed text-pretty text-hellblau">{item.text}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      variant === 'b' && (
        <div class="run mt-12 lg:mt-16" style={`--steps:${items.length}`} data-tasks-run>
          <div class="sticky top-(--header-height) flex h-[calc(100svh-var(--header-height)-1rem)] flex-col">
            <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-3xl bg-marine">
              <div class="belt lane relative min-h-0 flex-1 overflow-hidden" data-tasks-belt>
                {/* The camera's field: each part stops in it. */}
                <svg viewBox="0 0 400 300" class="slot" aria-hidden="true">
                  <path
                    d="M24 44V20h24M352 20h24v24M376 256v24h-24M48 280H24v-24"
                    fill="none"
                    stroke-width="2"
                    class="stroke-hellblau"
                  />
                </svg>
                {items.map((item, index) => (
                  <TaskScene
                    reading={item.part}
                    class:list={['slot piece', index === 0 && 'is-active']}
                    style={`--i:${index}`}
                    data-tasks-for={item.part}
                  />
                ))}
              </div>
              <div class="grid border-t border-hellblau/20 px-6 py-5 sm:px-10 sm:py-7">
                {items.map((item, index) => (
                  <div
                    class:list={[
                      'caption grid gap-2 lg:grid-cols-[1fr_1.4fr] lg:items-baseline lg:gap-16',
                      index === 0 && 'is-active',
                    ]}
                    data-tasks-for={item.part}
                  >
                    <div>
                      {item.meta && <p class="kicker text-hellblau">{item.meta}</p>}
                      <h3 class="mt-2 text-2xl font-semibold tracking-[-0.01em] text-weiss sm:text-3xl">{item.title}</h3>
                    </div>
                    {item.text && (
                      <p class="max-w-[52ch] leading-relaxed text-pretty text-hellblau sm:text-lg">{item.text}</p>
                    )}
                  </div>
                ))}
              </div>
            </div>

            <ol class="mt-4 grid grid-cols-5 gap-2 lg:gap-4">
              {items.map((item, index) => (
                <li>
                  <button
                    type="button"
                    class:list={['switch w-full pt-3 text-left lg:pt-4', index === 0 && 'is-active']}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    aria-label={item.title}
                    data-tasks-switch={item.part}
                  >
                    <span class="bar" aria-hidden="true" />
                    <span class="kicker block text-marine-70">{number(index)}</span>
                    <span class="mt-2 hidden font-semibold tracking-[-0.01em] hyphens-auto lg:block">{item.title}</span>
                  </button>
                </li>
              ))}
            </ol>
            {cta && (
              <p class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 lg:mt-6">
                {cta.lead && <span class="text-lg text-marine-70">{cta.lead}</span>}
                <ArrowLink href={ctaHref(cta, locale, source)}>{cta.label}</ArrowLink>
              </p>
            )}
          </div>
        </div>
      )
    }

    {
      variant === 'a' && (
        <ul class="switches mt-4 flex snap-x gap-3 overflow-x-auto lg:mt-6 lg:grid lg:grid-cols-6 lg:gap-4 lg:overflow-visible">
          {items.map((item, index) => (
            <li class="w-[62%] shrink-0 snap-start sm:w-[15rem] lg:w-auto">
              <button
                type="button"
                class:list={['switch w-full pt-4 text-left', index === 0 && 'is-active']}
                aria-pressed={index === 0 ? 'true' : 'false'}
                data-tasks-switch={item.part}
              >
                <span class="bar" aria-hidden="true" />
                <span class="kicker block text-marine-70">{number(index)}</span>
                <span class="mt-2 block font-semibold tracking-[-0.01em] hyphens-auto">{item.title}</span>
              </button>
            </li>
          ))}
          {cta && (
            <li class="w-[75%] shrink-0 snap-start rounded-2xl border border-dashed border-marine-45 p-4 sm:w-[17rem] lg:w-auto">
              {cta.lead && <p class="font-semibold tracking-[-0.01em]">{cta.lead}</p>}
              <ArrowLink href={ctaHref(cta, locale, source)} class="mt-4">
                {cta.label}
              </ArrowLink>
            </li>
          )}
        </ul>
      )
    }

    {
      variant === 'c' && (
        <>
          <ul class="strips mt-12 flex flex-col overflow-hidden rounded-3xl bg-marine lg:mt-16 lg:h-[30rem] lg:flex-row">
            {items.map((item, index) => (
              <li class:list={['strip', index === 0 && 'is-active']} data-tasks-for={item.part}>
                <button
                  type="button"
                  class="tab flex w-full items-baseline gap-4 p-5 text-left text-weiss sm:px-8"
                  aria-expanded={index === 0 ? 'true' : 'false'}
                  data-tasks-switch={item.part}
                >
                  <span class="kicker text-hellblau">{number(index)}</span>
                  <span class="title text-lg font-semibold tracking-[-0.01em]">{item.title}</span>
                </button>
                <div class="body">
                  <div class="inner lg:grid lg:grid-cols-[1fr_1.35fr] lg:items-center lg:gap-4">
                    <div class="px-5 sm:px-8 lg:pr-0 lg:pl-10">
                      {item.meta && <p class="kicker text-hellblau">{item.meta}</p>}
                      <h3 class="mt-3 hidden text-3xl font-semibold tracking-[-0.02em] text-weiss lg:block">
                        {item.title}
                      </h3>
                      {item.text && (
                        <p class="mt-3 max-w-[40ch] text-lg leading-relaxed text-pretty text-hellblau lg:mt-4">
                          {item.text}
                        </p>
                      )}
                    </div>
                    <div class="mt-4 px-5 pb-6 lg:mt-0 lg:px-6 lg:pb-0">
                      <TaskScene reading={item.part} class="mx-auto block w-full max-w-[30rem]" />
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ul>
          {cta && (
            <div class="mt-4 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 rounded-2xl border border-dashed border-marine-45 px-6 py-5 lg:mt-6">
              {cta.lead && <p class="text-lg font-semibold tracking-[-0.01em]">{cta.lead}</p>}
              <ArrowLink href={ctaHref(cta, locale, source)}>{cta.label}</ArrowLink>
            </div>
          )}
        </>
      )
    }
  </div>
</section>

<style>
  /* The belt: a lighter band behind the part, as if seen from above. */
  .belt::before {
    content: '';
    position: absolute;
    inset: 14% 0;
    border-block: 1px solid color-mix(in srgb, var(--color-hellblau) 25%, transparent);
    background: color-mix(in srgb, var(--color-weiss) 5%, transparent);
  }

  /* --- a: one scene at a time; a, b: one caption at a time ------------- */

  .scene,
  .caption {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 400ms ease-out,
      visibility 0s 400ms;
  }

  .scene.is-active,
  .caption.is-active {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  /*
   * (b) The belt runs with the scroll. The section stays pinned for a stretch
   * of scrolling per task; over it, --p runs from 0 to the last task's index
   * and every part sits (its index − p) slots from the camera's field.
   */
  [data-tasks-ready] .run {
    height: calc(100svh - var(--header-height) - 1rem + var(--steps) * 50vh);
  }

  .lane {
    --p: 0;
    --slot: 82cqw;
    container-type: size;
  }

  @media (min-width: 64rem) {
    .lane {
      --slot: 55cqw;
    }
  }

  /* Marks along the belt's edge, so it is seen to move. */
  .lane::after {
    content: '';
    position: absolute;
    inset: auto 0 14%;
    height: 0.5rem;
    background: repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-hellblau) 30%, transparent) 0 2px,
        transparent 2px 2.5rem
      )
      calc(var(--p) * var(--slot) * -1) 0;
  }

  .slot {
    position: absolute;
    top: 50%;
    left: 50%;
    height: min(86cqh, 64cqw);
    aspect-ratio: 4 / 3;
    translate: -50% -50%;
  }

  /* Outside the field a part is only a part: dimmed, and not yet read. */
  .piece {
    transform: translateX(calc((var(--i) - var(--p)) * var(--slot)));
    opacity: 0.35;
    transition: opacity 300ms ease-out;
  }

  .piece :global(.note) {
    opacity: 0;
    transition: opacity 300ms ease-out;
  }

  .piece.is-active,
  .lane:not(.is-moving) .piece.is-active :global(.note) {
    opacity: 1;
  }

  .switches {
    scrollbar-width: none;
  }

  .switches::-webkit-scrollbar {
    display: none;
  }

  .switch {
    position: relative;
    border-top: 2px solid var(--color-marine-15);
    color: var(--color-marine-70);
    transition: color 300ms ease-out;
  }

  .switch:hover,
  .switch.is-active {
    color: var(--color-marine);
  }

  /* The line over the active switch: full when picked by hand, filling up while
     the section plays by itself. The script moves on when it is full. */
  .bar {
    position: absolute;
    top: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-orange);
    transform-origin: left;
    transform: scaleX(0);
  }

  .switch.is-active .bar {
    transform: none;
  }

  [data-tasks-playing] .switch.is-active .bar {
    animation: fill 5s linear both;
  }

  [data-tasks-playing='paused'] .switch.is-active .bar {
    animation-play-state: paused;
  }

  @keyframes fill {
    from {
      transform: scaleX(0);
    }
  }

  /* --- c: strips --------------------------------------------------------- */

  .strips {
    container-type: inline-size;
  }

  .strip + .strip {
    border-top: 1px solid color-mix(in srgb, var(--color-hellblau) 20%, transparent);
  }

  /* Stacked: the open strip's body unfolds under its title. */
  .body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 500ms var(--ease-out-quint);
  }

  .strip.is-active .body {
    grid-template-rows: 1fr;
  }

  .inner {
    min-height: 0;
    overflow: hidden;
  }

  .strip:not(.is-active) .inner {
    visibility: hidden;
    transition: visibility 0s 500ms;
  }

  @media (min-width: 64rem) {
    /* Side by side: the open strip takes six parts of the width, the rest one each. */
    .strip {
      position: relative;
      flex: 1 1 0;
      min-width: 0;
      overflow: hidden;
      transition: flex-grow 600ms var(--ease-out-quint);
    }

    .strip.is-active {
      flex-grow: 6;
    }

    .strip + .strip {
      border-top: 0;
      border-left: 1px solid color-mix(in srgb, var(--color-hellblau) 20%, transparent);
    }

    /* Closed, a strip is all button: number on top, title running up the side. */
    .tab {
      position: absolute;
      inset: 0;
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      padding: 1.5rem;
      transition:
        opacity 300ms ease-out,
        background-color 300ms ease-out;
    }

    .tab:hover {
      background: color-mix(in srgb, var(--color-weiss) 5%, transparent);
    }

    .tab .title {
      writing-mode: vertical-rl;
      rotate: 180deg;
      white-space: nowrap;
    }

    .strip.is-active .tab {
      opacity: 0;
      pointer-events: none;
    }

    .body {
      position: absolute;
      inset: 0;
      display: block;
      opacity: 0;
      transition: opacity 250ms ease-out;
    }

    .strip.is-active .body {
      opacity: 1;
      transition-delay: 250ms;
    }

    /* As wide as the open strip, whatever the strip's width is right now, so the
       copy does not reflow while the strip opens. */
    .inner {
      width: 60cqw;
      height: 100%;
    }
  }
</style>

<script>
  /** Shows one task of a section and marks its switch. */
  function show(root: HTMLElement, reading: string) {
    for (const element of root.querySelectorAll<HTMLElement | SVGElement>('[data-tasks-for]')) {
      element.classList.toggle('is-active', element.dataset.tasksFor === reading);
    }
    for (const button of root.querySelectorAll<HTMLElement>('[data-tasks-switch]')) {
      const active = button.dataset.tasksSwitch === reading;
      button.classList.toggle('is-active', active);
      button.setAttribute(button.hasAttribute('aria-expanded') ? 'aria-expanded' : 'aria-pressed', String(active));

      // Keep the active switch in view in the scrolling row on small screens,
      // without moving the page.
      const list = button.closest('ul');
      if (active && list && list.scrollWidth > list.clientWidth) {
        list.scrollTo({ left: button.parentElement!.offsetLeft - list.offsetLeft });
      }
    }
  }

  /**
   * (a, b) Plays through the tasks. Driven by the fill animation of the active
   * switch's bar: when it ends, the next task is shown. It runs only while the
   * image is on screen and nobody is hovering or focusing the switches, and
   * stops for good once a switch is clicked.
   */
  function play(root: HTMLElement, switches: HTMLElement[], list: HTMLElement) {
    const image = root.querySelector('[data-tasks-image]');
    if (!image || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let visible = false;
    let held = false;
    function sync() {
      if ('tasksPlaying' in root.dataset) root.dataset.tasksPlaying = visible && !held ? 'running' : 'paused';
    }

    root.dataset.tasksPlaying = 'paused';
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        sync();
      },
      { threshold: 0.6 },
    ).observe(image);

    list.addEventListener('animationend', (event) => {
      const index = switches.indexOf((event.target as HTMLElement).closest('button')!);
      const next = switches[(index + 1) % switches.length];
      show(root, next.dataset.tasksSwitch!);
    });

    for (const [on, off] of [
      ['pointerenter', 'pointerleave'],
      ['focusin', 'focusout'],
    ]) {
      list.addEventListener(on, () => ((held = true), sync()));
      list.addEventListener(off, () => ((held = false), sync()));
    }
  }

  /** Share of each task's stretch of scrolling that its part rests in the field. */
  const DWELL = 0.5;
  const clamp = (value: number) => Math.min(1, Math.max(0, value));

  /**
   * (b) Runs the belt from the scroll position. While the section is pinned,
   * each task gets an equal stretch of scrolling: its part rests in the field
   * for the first half and the belt moves on to the next over the second. A
   * click on a switch scrolls to that task.
   */
  function run(root: HTMLElement, switches: HTMLElement[]) {
    const track = root.querySelector<HTMLElement>('[data-tasks-run]');
    const lane = root.querySelector<HTMLElement>('[data-tasks-belt]');
    const pinned = track?.firstElementChild as HTMLElement | null;
    if (!track || !lane || !pinned) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const last = switches.length - 1;
    let frame = 0;
    let shown = 0;

    /** The scrolling the pinned stretch takes, and where on the page it starts. */
    function stretch() {
      const offset = parseFloat(getComputedStyle(pinned!).top) || 0;
      return {
        length: track!.offsetHeight - pinned!.offsetHeight,
        start: window.scrollY + track!.getBoundingClientRect().top - offset,
      };
    }

    function update() {
      frame = 0;
      if (!root.isConnected) {
        window.removeEventListener('scroll', request);
        window.removeEventListener('resize', request);
        return;
      }

      const { length, start } = stretch();
      const at = clamp((window.scrollY - start) / length) * switches.length;
      const index = Math.min(last, Math.floor(at));
      const moved = index < last ? clamp((at - index - DWELL) / (1 - DWELL)) : 0;
      const eased = moved * moved * (3 - 2 * moved);
      const position = reducedMotion.matches ? Math.round(index + eased) : index + eased;

      const nearest = Math.round(position);
      lane!.style.setProperty('--p', position.toFixed(3));
      lane!.classList.toggle('is-moving', Math.abs(position - nearest) > 0.08);
      if (nearest !== shown) {
        shown = nearest;
        show(root, switches[nearest].dataset.tasksSwitch!);
      }
    }

    function request() {
      frame ||= requestAnimationFrame(update);
    }

    switches.forEach((button, index) => {
      button.addEventListener('click', () => {
        const { length, start } = stretch();
        window.scrollTo({
          top: start + ((index + DWELL / 2) / switches.length) * length,
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
        });
      });
    });

    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    update();
  }

  /** Initialised the same way as Header.astro. */
  function initVisionTasks() {
    for (const root of document.querySelectorAll<HTMLElement>('[data-tasks]')) {
      const switches = [...root.querySelectorAll<HTMLElement>('[data-tasks-switch]')];
      const list = switches[0]?.closest<HTMLElement>('ul, ol');
      if (!list || root.dataset.tasksReady) continue;
      root.dataset.tasksReady = 'true';

      if (root.dataset.tasks === 'b') {
        run(root, switches);
        continue;
      }

      const strips = root.dataset.tasks === 'c';
      if (!strips) play(root, switches, list);

      for (const button of switches) {
        const pick = () => {
          delete root.dataset.tasksPlaying;
          show(root, button.dataset.tasksSwitch!);
        };
        button.addEventListener('click', pick);
        // The strips also open under the mouse; touch and keyboard use the click.
        if (strips) {
          button.addEventListener('pointerenter', (event) => event.pointerType === 'mouse' && pick());
        }
      }
    }
  }

  document.addEventListener('astro:page-load', initVisionTasks);
  initVisionTasks();
</script>
