---
/**
 * The hero of every page except the homepage: the same Marine panel as
 * HomeHero, but sized to its content rather than to the viewport.
 */
interface Props {
  hero: { eyebrow?: string; headline: string; subline?: string; note?: string };
}

const { hero } = Astro.props;
---

<section class="px-4">
  <div
    class="relative overflow-hidden rounded-3xl bg-marine px-6 pt-16 pb-12 sm:px-12 sm:pt-24 lg:px-16 lg:pt-28"
  >
    <div class="mx-auto w-full max-w-[84rem]">
      {
        hero.eyebrow && (
          <p class="flex items-center gap-4">
            {/* Markenkern — square, 135° gradient, no radius (Guideline §05). */}
            <span class="markenkern size-7 shrink-0" aria-hidden="true" />
            <span class="kicker text-weiss">{hero.eyebrow}</span>
          </p>
        )
      }

      <h1
        class="mt-10 max-w-[16ch] text-[clamp(2.5rem,7vw,6rem)] leading-[0.95] font-black tracking-[-0.035em] text-balance text-weiss"
      >
        {hero.headline}
      </h1>

      {
        hero.subline && (
          <p class="mt-8 max-w-[46ch] text-lg leading-relaxed text-pretty text-hellblau sm:text-xl">
            {hero.subline}
          </p>
        )
      }

      {
        hero.note ? (
          <p class="mt-16 flex items-center gap-4 border-t border-hellblau/25 pt-8 lg:mt-24">
            {/* Pixel heart, drawn inline so it inherits the accent colour. */}
            <svg
              width="18"
              height="16"
              viewBox="0 0 9 8"
              class="shrink-0 text-orange"
              aria-hidden="true"
              fill="currentColor"
              shape-rendering="crispEdges"
            >
              <path d="M1 0h2v1H1zM6 0h2v1H6zM0 1h4v1H0zM5 1h4v1H5zM0 2h9v1H0zM0 3h9v1H0zM1 4h7v1H1zM2 5h5v1H2zM3 6h3v1H3zM4 7h1v1H4z" />
            </svg>
            <span class="kicker text-weiss">{hero.note}</span>
          </p>
        ) : (
          <div class="h-4 lg:h-12" />
        )
      }
    </div>
  </div>
</section>
