---
import type { Locale } from '../config';
import { ctaHref } from '../lib/content';

/**
 * The hero of every page except the homepage, on a white ground: an optional
 * back link, eyebrow, one headline, an optional intro and the CTAs. The
 * bordered card grids below it (PageSections, Karriere, Projekte) carry the
 * page from here.
 *
 * Slots, for the pages that need more than that:
 *   eyebrow   extra chips beside the eyebrow (technology, draft tag)
 *   default   anything under the CTAs (job facts, project facts)
 *   aside     a column to the right of the text on wide screens (project logo)
 *
 * CTAs need `locale` and `source`.
 */
interface Cta {
  label: string;
  page?: string;
  href?: string;
}

interface Props {
  hero: {
    eyebrow?: string;
    headline: string;
    /** A sentence or two under the headline. */
    intro?: string;
    note?: string;
    primaryCta?: Cta;
    secondaryCta?: Cta;
  };
  /** A "← back" link above the eyebrow, for detail pages. */
  back?: { href: string; label: string };
  locale?: Locale;
  /** The content file the hero came from, for error messages. */
  source?: string;
}

const { hero, back, locale, source = 'the page hero' } = Astro.props;
const hasCtas = locale && (hero.primaryCta || hero.secondaryCta);
const hasAside = Astro.slots.has('aside');
const arrow = 'M3 8h9m0 0-3.5-3.5M12 8l-3.5 3.5';
---

<section class="px-4 pt-20 pb-14 sm:px-16 sm:pt-28 lg:px-20 lg:pt-36 lg:pb-20">
  <div class:list={['mx-auto max-w-[84rem]', hasAside && 'grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16']}>
    <div class:list={[hasAside && 'lg:col-span-8']}>
      {
        back && (
          <a
            href={back.href}
            class="rise group mb-10 inline-flex items-center gap-3 text-sm font-medium text-marine-70 transition-colors hover:text-marine lg:mb-14"
          >
            <svg
              viewBox="0 0 16 16"
              class="size-4 rotate-180 transition-transform duration-300 group-hover:-translate-x-1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <path d={arrow} stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {back.label}
          </a>
        )
      }

      {
        (hero.eyebrow || Astro.slots.has('eyebrow')) && (
          <p class="rise flex flex-wrap items-center gap-x-4 gap-y-3">
            {hero.eyebrow && (
              <span class="flex items-center gap-3">
                {/* Markenkern — square, 135° gradient, no radius (Guideline §05). */}
                <span class="markenkern size-3 shrink-0" aria-hidden="true" />
                <span class="kicker text-marine-70">{hero.eyebrow}</span>
              </span>
            )}
            <slot name="eyebrow" />
          </p>
        )
      }

      <h1
        class="rise mt-6 max-w-[22ch] text-[clamp(2.25rem,5vw,4.5rem)] leading-[1] font-black tracking-[-0.035em] text-balance text-marine max-sm:hyphens-auto"
        style="animation-delay: 60ms"
      >
        {hero.headline}
      </h1>

      {
        hero.intro && (
          <p
            class="rise mt-6 max-w-[62ch] text-lg leading-relaxed text-pretty text-marine-70 sm:text-xl"
            style="animation-delay: 120ms"
          >
            {hero.intro}
          </p>
        )
      }

      {
        hasCtas && (
          <div class="rise mt-10 flex flex-wrap items-center gap-3" style="animation-delay: 180ms">
            {hero.primaryCta && (
              <a href={ctaHref(hero.primaryCta, locale, source)} class="btn btn-primary">
                {hero.primaryCta.label}
              </a>
            )}
            {hero.secondaryCta && (
              <a href={ctaHref(hero.secondaryCta, locale, source)} class="btn btn-outline">
                {hero.secondaryCta.label}
              </a>
            )}
          </div>
        )
      }

      {
        Astro.slots.has('default') && (
          <div class="rise" style="animation-delay: 180ms">
            <slot />
          </div>
        )
      }

      {
        hero.note && (
          <p class="rise mt-10 flex items-center gap-3" style="animation-delay: 240ms">
            {/* Pixel heart, drawn inline so it inherits the accent colour. */}
            <svg
              width="18"
              height="16"
              viewBox="0 0 9 8"
              class="shrink-0 text-orange"
              aria-hidden="true"
              fill="currentColor"
              shape-rendering="crispEdges"
            >
              <path d="M1 0h2v1H1zM6 0h2v1H6zM0 1h4v1H0zM5 1h4v1H5zM0 2h9v1H0zM0 3h9v1H0zM1 4h7v1H1zM2 5h5v1H2zM3 6h3v1H3zM4 7h1v1H4z" />
            </svg>
            <span class="kicker text-marine-70">{hero.note}</span>
          </p>
        )
      }
    </div>

    {
      hasAside && (
        <div class="rise lg:col-span-4" style="animation-delay: 240ms">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  /* A short staggered rise on load; reduced motion is neutralised globally. */
  .rise {
    animation: rise 0.9s var(--ease-out-quint) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
</style>
