---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE_NAME, type Locale } from '../config';
import { postAlternates } from '../lib/content';
import { resolveImage } from '../lib/images';
import { useTranslations } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = useTranslations(locale);

const { Content } = await render(entry);
const alternates = await postAlternates(entry);
const heroImage = resolveImage(entry.data.heroImage);

const dateFormat = new Intl.DateTimeFormat(locale === 'de' ? 'de-DE' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// BlogPosting structured data — helps Google render article rich results.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  ...(entry.data.updatedAt && { dateModified: entry.data.updatedAt.toISOString() }),
  ...(entry.data.author && { author: { '@type': 'Person', name: entry.data.author } }),
  publisher: { '@type': 'Organization', name: SITE_NAME },
  inLanguage: locale,
};
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  alternates={alternates}
  ogImage={entry.data.ogImage}
  ogType="article"
  noindex={entry.data.noindex}
  structuredData={structuredData}
>
  <article class="mx-auto max-w-3xl px-4 py-20">
    <header>
      <time datetime={entry.data.publishedAt.toISOString()} class="text-sm text-neutral-500">
        {t('blog.publishedOn')} {dateFormat.format(entry.data.publishedAt)}
        {entry.data.author && <> · {t('blog.by')} {entry.data.author}</>}
      </time>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        {entry.data.title}
      </h1>
      <p class="mt-4 text-lg text-neutral-600 text-pretty">{entry.data.description}</p>
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={entry.data.heroImageAlt ?? ''}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 768px) 768px, 100vw"
          class="mt-10 w-full rounded-2xl"
          loading="eager"
        />
      )
    }

    <div class="prose mt-12">
      <Content />
    </div>
  </article>
</BaseLayout>
