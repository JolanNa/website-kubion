---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE_NAME, type Locale } from '../config';
import { getAuthor, postAlternates } from '../lib/content';
import { resolveImage } from '../lib/images';
import { useTranslations } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorCard from './AuthorCard.astro';
import CtaPanel from './CtaPanel.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = useTranslations(locale);

const { Content } = await render(entry);
const alternates = await postAlternates(entry);
const heroImage = resolveImage(entry.data.heroImage);

// `author` holds a team member's translationKey; anything else is a plain name.
const author = await getAuthor(entry.data.author, locale);
const authorName = author?.data.name ?? entry.data.author;

const cta = {
  kicker: t('blog.cta.kicker'),
  heading: t('blog.cta.heading'),
  text: t('blog.cta.text'),
  primaryCta: { label: t('blog.cta.primary'), page: 'kontakt' },
  secondaryCta: { label: t('blog.cta.secondary'), page: 'blog' },
};

const dateFormat = new Intl.DateTimeFormat(locale === 'de' ? 'de-DE' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// BlogPosting structured data — helps Google render article rich results.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  ...(entry.data.updatedAt && { dateModified: entry.data.updatedAt.toISOString() }),
  ...(authorName && { author: { '@type': 'Person', name: authorName } }),
  publisher: { '@type': 'Organization', name: SITE_NAME },
  inLanguage: locale,
};
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  alternates={alternates}
  ogImage={entry.data.ogImage}
  ogType="article"
  noindex={entry.data.noindex}
  structuredData={structuredData}
>
  <div
    class:list={[
      'blog-post mx-auto grid max-w-3xl gap-12 px-4 py-20 text-lila',
      author && 'lg:max-w-[68rem] lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-16',
    ]}
  >
    <article class="min-w-0">
      <header>
        <time datetime={entry.data.publishedAt.toISOString()} class="text-sm opacity-70">
          {t('blog.publishedOn')} {dateFormat.format(entry.data.publishedAt)}
          {authorName && <> · {t('blog.by')} {authorName}</>}
        </time>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
          {entry.data.title}
        </h1>
        <p class="mt-4 text-lg text-pretty opacity-80">{entry.data.description}</p>
      </header>

      {
        heroImage && (
          <Image
            src={heroImage}
            alt={entry.data.heroImageAlt ?? ''}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 768px) 768px, 100vw"
            class="mt-10 w-full rounded-2xl"
            loading="eager"
          />
        )
      }

      {
        entry.data.summary && (
          <div class="mt-10 rounded-2xl bg-nebel p-6 sm:p-8">
            <p class="kicker font-bold! opacity-70">{t('blog.summary')}</p>
            <p class="mt-3 text-lg leading-relaxed text-pretty">{entry.data.summary}</p>
          </div>
        )
      }

      <div class="prose mt-12">
        <Content />
      </div>
    </article>

    {/* After the article in the source, beside it on the left from `lg` up. */}
    {
      author && (
        <AuthorCard
          member={author}
          locale={locale}
          class="lg:sticky lg:top-[calc(var(--header-height)+1rem)] lg:order-first lg:self-start"
        />
      )
    }
  </div>

  <CtaPanel section={cta} locale={locale} source="src/components/BlogPost.astro" />
</BaseLayout>
